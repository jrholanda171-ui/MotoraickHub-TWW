            local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
            local animals = entities and entities:FindFirstChild("Animals")
            if animals then
                for _, anim in ipairs(animals:GetChildren()) do
                    local animName = anim.Name:lower()
                    local shouldKeep = false
                    if AnimalESP.Bear and animName:find("bear") then shouldKeep = true
                    elseif AnimalESP.Bison and animName:find("bison") then shouldKeep = true
                    elseif AnimalESP.Deer and (animName:find("deer") or animName:find("buck") or animName:find("doe")) then shouldKeep = true
