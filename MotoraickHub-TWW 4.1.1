function UpdateThunderstruckESP(m)
    if not m or not m.Parent then return end

    -- Check if tree is chopped / destroyed
    local isChopped = false
    if m:GetAttribute("Chopped") == true or m:GetAttribute("Cut") == true or m:GetAttribute("Destroyed") == true or m:GetAttribute("Dead") == true then
        isChopped = true
    end
    local logs = m:FindFirstChild("LogsRemaining")
    if logs and logs:IsA("ValueBase") and logs.Value <= 0 then
        isChopped = true
    end
    local hum = m:FindFirstChildOfClass("Humanoid") or m:FindFirstChild("Humanoid")
    if hum and hum.Health <= 0 then
        isChopped = true
    end
    if m:FindFirstChild("Stump") and not m:FindFirstChild("TreeTrunk") and not m:FindFirstChild("Trunk") and not m:FindFirstChild("Leaves") then
        isChopped = true
    end

    local root = m:IsA("Model") and (m:FindFirstChild("TreeTrunk") or m:FindFirstChild("Trunk") or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")) or (m:IsA("BasePart") and m)
    
    if isChopped or not root then
        if root then
            local tag = root:FindFirstChild("ThunderTag")
            if tag then tag:Destroy() end
        end
        local tagOnModel = m:FindFirstChild("ThunderTag", true)
        if tagOnModel then tagOnModel:Destroy() end
        return
    end
    
    local dist = (root.Position - Camera.CFrame.Position).Magnitude
    if dist > PlayerESP.MaxDistance then
        local tag = root:FindFirstChild("ThunderTag")
        if tag then tag:Destroy() end
        return
    end

    local tag = root:FindFirstChild("ThunderTag")
    if not tag then
        tag = Instance.new("BillboardGui")
        tag.Name = "ThunderTag"
        tag.Size = UDim2.new(0, 220, 0, 30)
        tag.AlwaysOnTop = true
        tag.Adornee = root
        tag.Parent = root
        
        local l = Instance.new("TextLabel", tag)
        l.Name = "Text"
        l.Size = UDim2.new(1, 0, 1, 0)
        l.BackgroundTransparency = 1
        l.Font = Enum.Font.GothamBold
        l.TextSize = 9
        l.TextStrokeTransparency = 0.25
        l.TextStrokeColor3 = Color3.new(0, 0, 0)
    end
    
    tag.Enabled = true
    local l = tag:FindFirstChild("Text")
    if l then
        l.TextColor3 = Color3.fromRGB(0, 200, 255)
        l.Text = string.format("⚡ Thunderstruck [%dm]", math.floor(dist))
    end
end

function RunInstantPickup()
    if not InstantPickupConfig.Enabled then return end
    
    local oag = Global.LoadModule and Global.LoadModule("ObjectActionGroups")
    if not oag then return end
    
    local closest = oag.ClosestObjectAction
    if closest and closest.Active then
        local primary = closest.ActionFrames and closest.ActionFrames.Primary
        if primary and primary.ActivateStart and primary.ActivateEnd and not primary.Disabled then
            local aType = closest.ActionGroupType or ""
            if aType:find("Pickup") or aType:find("Loot") or aType:find("Grab") or aType:find("Money") or aType:find("Item") or aType:find("Bag") then
                pcall(function()
                    primary:ActivateStart()
                end)
                local dur = (primary.ActionInfo and primary.ActionInfo.Duration) or 0.5
                task.wait(math.max(dur + 0.04, 0.52))
                pcall(function()
                    primary:ActivateEnd()
                end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.08)
        if InstantPickupConfig.Enabled then
            pcall(RunInstantPickup)
        end
    end
end)

