function GetAnimalRoot(anim)
    if not anim then return nil end
    local root = anim:FindFirstChild("HumanoidRootPart") 
        or anim:FindFirstChild("Torso") 
        or anim:FindFirstChild("Head") 
        or anim:FindFirstChild("Body")
    if not root and anim:IsA("Model") then
        pcall(function() root = anim.PrimaryPart end)
    end
    if not root then
        root = anim:FindFirstChildWhichIsA("BasePart")
    end
    return root
end

function GetNPCRig(npc)
    if not npc then return nil end
    local innerModel = npc:FindFirstChild("Model")
    if not innerModel then return nil end
    local rig = innerModel:FindFirstChildOfClass("Model")
    return rig or innerModel
end

function GetNPCHumanoid(npc)
