-- Path Save/Load System
v3_PATHS_FOLDER = "MOTORAICK_HUB/FarmPaths"

function v3_EnsurePathFolder()
    pcall(function()
        if not isfolder(v3_PATHS_FOLDER) then
            makefolder("MOTORAICK_HUB")
            makefolder(v3_PATHS_FOLDER)
        end
    end)
end

function v3_SavePath(name)
    if not name or name == "" then
        Notify("Please enter a path name!", 2, true)
        return
    end
    if #v3_savedPathPositions == 0 then
        Notify("No path recorded to save!", 2, true)
        return
    end
    v3_EnsurePathFolder()
    local data = {}
    for _, pos in ipairs(v3_savedPathPositions) do
        table.insert(data, {x = pos.X, y = pos.Y, z = pos.Z})
    end
    local json = game:GetService("HttpService"):JSONEncode(data)
    local ok, err = pcall(function()
        writefile(v3_PATHS_FOLDER .. "/" .. name .. ".json", json)
    end)
    if ok then
        Notify("Path '" .. name .. "' saved! (" .. #data .. " points)", 3)
        if Options and Options.LoadPathDropdown then
            Options.LoadPathDropdown:SetValues(v3_GetSavedPathNames())
            Options.LoadPathDropdown:SetValue(name)
        end
    else
        Notify("Error saving path: " .. tostring(err), 3, true)
    end
end

function v3_LoadPath(name)
    if not name or name == "" then
        Notify("Select a path to load!", 2, true)
        return
    end
    v3_EnsurePathFolder()
    local ok, json = pcall(function()
        return readfile(v3_PATHS_FOLDER .. "/" .. name .. ".json")
    end)
    if not ok or not json or json == "" then
        Notify("Failed to load path: " .. name, 2, true)
        return
    end
    local parseOk, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(json)
    end)
    if not parseOk or type(data) ~= "table" then
        Notify("Corrupt path file: " .. name, 2, true)
        return
    end

    v3_savedPathPositions = {}
    v3_visualFolder:ClearAllChildren()
    local lastPos = nil
    for _, p in ipairs(data) do
        local pos = Vector3.new(p.x, p.y, p.z)
        table.insert(v3_savedPathPositions, pos)
        v3_CreatePoint(pos)
        if lastPos then v3_DrawLine(lastPos, pos) end
        lastPos = pos
    end
    v3_lastPointPos, v3_lastFloorPos = nil, nil
    Notify("Path '" .. name .. "' loaded! (" .. #data .. " points)", 3)
end

function v3_DeletePath(name)
    if not name or name == "" then
        Notify("Select a path to delete!", 2, true)
        return
    end
    v3_EnsurePathFolder()
    local path = v3_PATHS_FOLDER .. "/" .. name .. ".json"
    pcall(function()
        if isfile and isfile(path) then
            delfile(path)
        end
    end)
    Notify("Path '" .. name .. "' deleted!", 2)
    if Options and Options.LoadPathDropdown then
        Options.LoadPathDropdown:SetValues(v3_GetSavedPathNames())
    end
end

function v3_GetSavedPathNames()
    v3_EnsurePathFolder()
    local names = {}
    pcall(function()
        local files = listfiles(v3_PATHS_FOLDER)
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(names, n) end
        end
    end)
    return names
end

function v3_GetClosestWaypointIndex(pos)
    if #v3_savedPathPositions == 0 then return 1 end
    local closestIndex = 1
    local shortestDist = math.huge
    for idx, wp in ipairs(v3_savedPathPositions) do
        local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(wp.X, 0, wp.Z)).Magnitude
        if dist < shortestDist then
            shortestDist = dist
            closestIndex = idx
        end
    end
    return closestIndex
end

function v3_AutoSellLoot()
    local oag = Global.ObjectActionGroups
    if oag then
        -- 1. Check ClosestObjectAction
        local closest = oag.ClosestObjectAction
        if closest and closest.ActionFrames then
            for _, frame in pairs(closest.ActionFrames) do
                if frame.ActionInfo and (frame.ActionInfo.NetworkEvent == "SellAllLoot" or (frame.ActionInfo.Description and frame.ActionInfo.Description:lower():find("sell"))) then
                    pcall(function()
                        frame:ActivateStart()
                        task.wait((frame.ActionInfo.Duration or 0.5) + 0.1)
                        frame:ActivateEnd()
                    end)
                    return true
                end
            end
        end

        -- 2. Check NearbyEntries
        if oag.NearbyEntries then
            for _, entry in ipairs(oag.NearbyEntries) do
                if entry.ObjectAction and entry.ObjectAction.ActionFrames then
                    for _, frame in pairs(entry.ObjectAction.ActionFrames) do
                        if frame.ActionInfo and (frame.ActionInfo.NetworkEvent == "SellAllLoot" or (frame.ActionInfo.Description and frame.ActionInfo.Description:lower():find("sell"))) then
                            pcall(function()
                                frame:ActivateStart()
                                task.wait((frame.ActionInfo.Duration or 0.5) + 0.1)
                                frame:ActivateEnd()
                            end)
                            return true
                        end
                    end
                end
            end
        end
    end

    -- 3. Fallback: Hold F Key for 0.8s
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        task.wait(0.8)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
    end)
    return true
end

