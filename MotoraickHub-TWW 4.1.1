-- ============================================================
-- BRIDGE: Variables referenced by UI but defined outside core
-- Wrapped in pcall so errors here don't block the UI
-- ============================================================
do
    local _ok, _err = pcall(function()
        PartNames = {"LeftFoot", "LeftHand", "LeftLowerArm", "LeftLowerLeg", "LeftUpperArm", "LeftUpperLeg", "RightFoot", "RightHand", "RightLowerArm", "RightLowerLeg", "RightUpperArm", "RightUpperLeg", "UpperTorso", "LowerTorso", "Head"}
        function GetCharId()
            if RepCharHandler then
                local success, repChar = pcall(function() return RepCharHandler:GetRepChar(LocalPlayer) end)
                if success and repChar then
                    if repChar.State then
                        if repChar.State.CharId and repChar.State.CharId ~= "" then return repChar.State.CharId end
                        if repChar.State.Reference and repChar.State.Reference ~= "" then
                            local ref = repChar.State.Reference
                            return ref:sub(1, 2) == "R " and ref:sub(3) or ref
                        end
                    end
                    if repChar.NetworkId and repChar.NetworkId ~= "" then return repChar.NetworkId end
                end
            end
            if Global.PlayerCharacter then
                local pc = Global.PlayerCharacter
                if pc.State then
                    if pc.State.CharId and pc.State.CharId ~= "" then return pc.State.CharId end
                    if pc.State.Reference and pc.State.Reference ~= "" then
                        local ref = pc.State.Reference
                        return ref:sub(1, 2) == "R " and ref:sub(3) or ref
                    end
                end
                if pc.NetworkId and pc.NetworkId ~= "" then return pc.NetworkId end
            end
            return nil
        end
        function BuildReference(partName)
            local charId = GetCharId()
            if not charId then return nil end
            for i, name in ipairs(PartNames) do
                if name == partName then return string.char(i - 1) .. charId end
            end
            return nil
        end
        function GetPartReference(partInstance)
            local char = getTWWCharacter(LocalPlayer)
            if not char then return nil end
            local ref = BuildReference(partInstance.Name)
            if ref then return ref end
            pcall(function() ref = Global.Network:GetReference(partInstance, "CharacterPart") end)
            return ref
        end
    end)
    if not _ok then warn("[MOTORAICK HUB] Bridge-1 error: " .. tostring(_err)) end
end

ParticleConfig = ParticleConfig or { Enabled=false, ServerMode=false, ActiveTypes={}, Speed=1, Offset = {X=0, Y=-2, Z=0} }
SoundConfig = SoundConfig or { Enabled=false, ServerMode=true, ActiveTypes={}, Speed=1, LocalVolume = 50 }

do
    local _ok2, _err2 = pcall(function()
        local LocalSounds = { ["Wood"] = "rbxassetid://3738658758", ["Snow"] = "rbxassetid://3077391486" }

        function PlayLocalSound(sndType, pos, vol)
            local id = LocalSounds[sndType]
            if not id then return end
            pcall(function()
                local sound = Instance.new("Sound")
                sound.SoundId = id
                sound.Volume = (vol or 50) / 10
                sound.MaxDistance = 100
                local part = Instance.new("Part")
                part.Anchored = true
                part.CanCollide = false
                part.Transparency = 1
                part.Position = pos
                part.Parent = Workspace
                sound.Parent = part
                sound:Play()
                Debris:AddItem(part, 2)
            end)
        end

        function EmitCustomParticle(particleType, config)
            local char = getTWWCharacter(LocalPlayer)
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local pos, velocity
            local normal = Vector3.new(0, 1, 0)
            if config == SoundConfig then
                pos = hrp.Position - Vector3.new(0, 2.5, 0)
                velocity = Vector3.new(0, 150, 0)
            else
                if particleType == "Water" or particleType == "Mud" then
                    local offsetCF = CFrame.new(config.Offset.X, config.Offset.Y, config.Offset.Z)
                    pos = (hrp.CFrame * offsetCF).Position
                else
                    pos = hrp.Position - Vector3.new(0, 2.5, 0)
                end
                velocity = Vector3.new(0, 10, 0)
            end
            if config.ServerMode and Global.Network then
                if particleType == "Water" then
                    Global.Network:FireServer("CreateWaterSplash", pos)
                else
                    local upperTorso = char:FindFirstChild("UpperTorso")
                    if upperTorso then
                        local partRef = GetPartReference(upperTorso)
                        if partRef then
                            Global.Network:FireServer("RagdollImpact", partRef, particleType, velocity, pos, normal)
                        else
                            local charId = GetCharId()
                            if charId then
                                local manualRef = string.char(12) .. charId
                                Global.Network:FireServer("RagdollImpact", manualRef, particleType, velocity, pos, normal)
                            end
                        end
                    end
                end
            end
            if config == SoundConfig then PlayLocalSound(particleType, pos, SoundConfig.LocalVolume) end
            if config == ParticleConfig and Global.VFX then
                local cf = CFrame.new(pos, pos + normal)
                if particleType == "Water" then Global.VFX.CreateWaterSplash(cf, 0.5)
                elseif particleType == "Mud" then Global.VFX.CreateMudSplash(cf)
                elseif particleType == "Sand" or particleType == "Limestone" then Global.VFX.LocalCreateDust(pos, velocity, Color3.fromRGB(255, 203, 139))
                elseif particleType == "Ground" then Global.VFX.LocalCreateDust(pos, velocity, Color3.fromRGB(155, 105, 47))
                end
            end
        end

        task.spawn(function()
            while true do
                if ParticleConfig.Enabled then
                    local typesToEmit = {}
                    for k, v in pairs(ParticleConfig.ActiveTypes) do if v then table.insert(typesToEmit, k) end end
                    for _, pType in ipairs(typesToEmit) do pcall(EmitCustomParticle, pType, ParticleConfig) end
                    task.wait(1 / math.max(0.01, ParticleConfig.Speed))
                else task.wait(0.5) end
            end
        end)
        task.spawn(function()
            while true do
                if SoundConfig.Enabled then
                    local typesToEmit = {}
                    for k, v in pairs(SoundConfig.ActiveTypes) do if v then table.insert(typesToEmit, k) end end
                    for _, sType in ipairs(typesToEmit) do pcall(EmitCustomParticle, sType, SoundConfig) end
                    task.wait(1 / math.max(0.01, SoundConfig.Speed))
                else task.wait(0.5) end
            end
        end)
    end)
    if not _ok2 then warn("[MOTORAICK HUB] Bridge-2 error: " .. tostring(_err2)) end
end

