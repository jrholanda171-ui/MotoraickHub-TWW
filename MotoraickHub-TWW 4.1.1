    local b64chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local function b64decode(data)
        if crypt and crypt.base64decode then return crypt.base64decode(data) end
        if syn and syn.crypt and syn.crypt.base64 and syn.crypt.base64.decode then return syn.crypt.base64.decode(data) end
        data = string.gsub(data, '[^'..b64chars..'=]', '')
        return (data:gsub('..?.?.?', function(x)
            if (#x < 4) then return '' end
            local c = 0
            for i = 1, 4 do
                local ch = x:sub(i, i)
                local v = (b64chars:find(ch, 1, true) or 1) - 1
                c = c + v * (64 ^ (4 - i))
            end
            local c1 = math.floor(c / 65536) % 256
            local c2 = math.floor(c / 256) % 256
            local c3 = c % 256
            if x:sub(4, 4) == '=' then
                if x:sub(3, 3) == '=' then return string.char(c1)
                else return string.char(c1, c2) end
            end
            return string.char(c1, c2, c3)
        end))
    end

    local function LoadScript(path)
        local cacheFile = "MOTORAICK_HUB/" .. path:gsub("/", "_")
        pcall(function()
            if not isfolder("MOTORAICK_HUB") then makefolder("MOTORAICK_HUB") end
        end)

        -- 1. Try Direct Raw GitHub
        local rawUrl = 'https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/' .. path
        local ok, src = pcall(function() return game:HttpGet(rawUrl) end)
        if ok and src and #src > 1000 and not src:find("429") and not src:find("<!DOCTYPE") then
            pcall(function() writefile(cacheFile, src) end)
            local fn, compileErr = loadstring(src)
            if fn then return fn() end
        end

        -- 2. Try GitHub API (bypasses raw.githubusercontent.com 429 rate limit)
        local apiUrl = 'https://api.github.com/repos/violin-suzutsuki/LinoriaLib/contents/' .. path
        local apiOk, apiRes = pcall(function() return game:HttpGet(apiUrl) end)
        if apiOk and apiRes and apiRes:find('"content"') then
            local jsonOk, json = pcall(function() return game:GetService("HttpService"):JSONDecode(apiRes) end)
            if jsonOk and json and json.content then
                local cleanB64 = json.content:gsub("%s+", "")
                local decoded = b64decode(cleanB64)
                if decoded and #decoded > 1000 then
                    pcall(function() writefile(cacheFile, decoded) end)
                    local fn, compileErr = loadstring(decoded)
                    if fn then return fn() end
                end
            end
        end

        -- 3. Fallback to Local Cache if available
        if isfile and isfile(cacheFile) then
            local cOk, cData = pcall(function() return readfile(cacheFile) end)
            if cOk and cData and #cData > 1000 then
                local fn = loadstring(cData)
                if fn then return fn() end
            end
        end

        error("Could not load script from any source: " .. path)
