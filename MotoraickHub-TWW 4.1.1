function UpdateCrosshair()
    if not CSGOCrosshair.Gui then InitializeCrosshairGui() end
    UpdateDefaultCrosshairVisibility()

    local enabled = CSGOCrosshair.Enabled
    CSGOCrosshair.Gui.Enabled = enabled
    if not enabled then return end

    local kind = CSGOCrosshair.Type
    local col = CSGOCrosshair.Color
    local size = CSGOCrosshair.Size
    local thick = CSGOCrosshair.Thickness
    local gap = CSGOCrosshair.Gap
    local outline = CSGOCrosshair.Outline
    local outCol = CSGOCrosshair.OutlineColor
    local outThick = CSGOCrosshair.OutlineThickness
    local trans = CSGOCrosshair.Transparency

    local top, bot, left, right = CSGOCrosshair.Top, CSGOCrosshair.Bottom, CSGOCrosshair.Left, CSGOCrosshair.Right
    local shape = CSGOCrosshair.Shape
    local textShape = CSGOCrosshair.TextShape
    local corner = CSGOCrosshair.Corner
    local sShape = CSGOCrosshair.Stroke
    local sText = CSGOCrosshair.TextStroke

    function updateStroke(obj)
        local s = obj:FindFirstChildOfClass("UIStroke")
        if s then
            s.Enabled = outline
            s.Color = outCol
            s.Thickness = outThick
            s.Transparency = trans
        end
        obj.BackgroundColor3 = col
        obj.BackgroundTransparency = trans
    end

    if kind == "Standard" then
        shape.Visible = false
        textShape.Visible = false
        top.Visible = true; bot.Visible = true; left.Visible = true; right.Visible = true
        
        updateStroke(top); updateStroke(bot); updateStroke(left); updateStroke(right)
        
        top.Size = UDim2.new(0, thick, 0, size)
        bot.Size = UDim2.new(0, thick, 0, size)
        left.Size = UDim2.new(0, size, 0, thick)
        right.Size = UDim2.new(0, size, 0, thick)
        
        top.AnchorPoint = Vector2.new(0.5, 1) 
        top.Position = UDim2.new(0.5, 0, 0.5, -gap)
        
        bot.AnchorPoint = Vector2.new(0.5, 0)
        bot.Position = UDim2.new(0.5, 0, 0.5, gap)

        left.AnchorPoint = Vector2.new(1, 0.5) 
        left.Position = UDim2.new(0.5, -gap, 0.5, 0)

        right.AnchorPoint = Vector2.new(0, 0.5)
        right.Position = UDim2.new(0.5, gap, 0.5, 0)

    else
        top.Visible = false; bot.Visible = false; left.Visible = false; right.Visible = false
        
        if kind == "Triangle" then
            shape.Visible = false
            textShape.Visible = true
            
            textShape.TextColor3 = col
            textShape.TextTransparency = trans
            textShape.TextSize = size + 10 
            textShape.Size = UDim2.new(0, size+10, 0, size+10)
            
            sText.Enabled = outline
            sText.Color = outCol
            sText.Thickness = outThick
            sText.Transparency = trans
            
        else
            textShape.Visible = false
            shape.Visible = true
            updateStroke(shape)
            
            local actualSize = (thick * 2) + 4
            shape.Size = UDim2.new(0, actualSize, 0, actualSize)
            
            if kind == "Square" then
                corner.CornerRadius = UDim.new(0, 0)
            elseif kind == "Circle" then
                corner.CornerRadius = UDim.new(1, 0)
            end
        end
    end
end

