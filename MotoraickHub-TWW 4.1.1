-- TARGET PLAYER SYSTEM (PLAYER-BASED, NOT CHARACTER-BASED)
------------------------------------------------------------
local TargetPlayer: any = {
    Enabled = false,
    TargetPlayer = nil,  -- A PLAYER objektum (fix)
    TargetName = "",
    Locked = false,
    TargetHighlight = nil,
    WaitingForRespawn = false,
    Keybind = nil
}

function GetClosestPlayerToCrosshair()
    local mousePos = UserInputService:GetMouseLocation()
    local closest = nil
    local closestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = getTWWCharacter(player)
            if char then
                local humanoid = char:FindFirstChild("Humanoid")
                local head = char:FindFirstChild("Head")
                
                if humanoid and humanoid.Health > 0 and head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        
                        if dist < closestDist then
                            closestDist = dist
                            closest = player  -- PLAYER
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

function ClearTarget()
    TargetPlayer.Locked = false
    TargetPlayer.TargetPlayer = nil
    TargetPlayer.TargetName = ""
    TargetPlayer.WaitingForRespawn = false
    
    if TargetPlayer.TargetHighlight then
        TargetPlayer.TargetHighlight:Destroy()
        TargetPlayer.TargetHighlight = nil
    end
end

function UpdateHighlight(char)
    if TargetPlayer.TargetHighlight then
        TargetPlayer.TargetHighlight:Destroy()
        TargetPlayer.TargetHighlight = nil
    end
    
    if char then
        TargetPlayer.TargetHighlight = Instance.new("Highlight")
        TargetPlayer.TargetHighlight.Adornee = char
        TargetPlayer.TargetHighlight.FillColor = Color3.fromRGB(255, 128, 0)
        TargetPlayer.TargetHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        TargetPlayer.TargetHighlight.FillTransparency = 0.5
        TargetPlayer.TargetHighlight.OutlineTransparency = 0
        TargetPlayer.TargetHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        TargetPlayer.TargetHighlight.Parent = CoreGui
    end
end

function LockTarget()
    if TargetPlayer.Locked then
        ClearTarget()
        Notify("🔓 Target Unlocked", 1)
        return
    end
    
    local player = GetClosestPlayerToCrosshair()
    
    if player then
        ClearTarget()
        
        TargetPlayer.TargetPlayer = player  -- PLAYER objektum!
        TargetPlayer.TargetName = player.Name
        TargetPlayer.Locked = true
        
        local char = getTWWCharacter(player)
        if char then
            UpdateHighlight(char)
        end
        
        Notify("🎯 LOCKED: " .. TargetPlayer.TargetName, 2)
    else
        Notify("❌ No target found", 1)
    end
end

function ToggleTargetPlayer(state)
    TargetPlayer.Enabled = state
    
    if not state then
        ClearTarget()
        Notify("Target System Disabled", 1)
    else
        Notify("Target System Enabled", 1)
    end
end

-- MAIN TRACKING LOOP - PLAYER BASED!
RunService.RenderStepped:Connect(function()
    if not TargetPlayer.Enabled or not TargetPlayer.Locked or not TargetPlayer.TargetPlayer then
        return
    end
    
    -- Ellenőrizzük hogy a player még a serverben van-e
    if not TargetPlayer.TargetPlayer.Parent then
        ClearTarget()
        Notify("❌ Target left the game", 2)
        return
    end
    
    -- We call the character fresh!
    local char = getTWWCharacter(TargetPlayer.TargetPlayer)
    
    if not char then
        -- No character, respawning happening
        if not TargetPlayer.WaitingForRespawn then
            TargetPlayer.WaitingForRespawn = true
            UpdateHighlight(nil)  -- We Delete Highlight
            Notify("⏳ Waiting for " .. TargetPlayer.TargetName .. " to respawn...", 2)
        end
        return
    end
    
    local humanoid = char:FindFirstChild("Humanoid")
    local head = char:FindFirstChild("Head")
    
    if not head or not humanoid then
        return
    end
    
    -- RESPAWN HAPPENED WE GOT HIS CHARACTER AGAIN!
    if TargetPlayer.WaitingForRespawn then
        if humanoid.Health > 0 then
            TargetPlayer.WaitingForRespawn = false
            UpdateHighlight(char)
            
            -- INSTANT CAMERA SNAP FOR NEW POSITION!
            local screenPos = Camera:WorldToViewportPoint(head.Position)
            local mousePos = UserInputService:GetMouseLocation()
            local deltaX = (screenPos.X - mousePos.X) * 5  -- 5x erő = INSTANT
            local deltaY = (screenPos.Y - mousePos.Y) * 5
            mousemoverel(deltaX, deltaY)
            
            Notify("⚡ RELOCKED: " .. TargetPlayer.TargetName, 2)
        end
        return
    end
    
    -- DEAD - Waiting for respawn!
    if humanoid.Health <= 0 then
        if not TargetPlayer.WaitingForRespawn then
            TargetPlayer.WaitingForRespawn = true
            UpdateHighlight(nil)
            Notify("☠️ " .. TargetPlayer.TargetName .. " died - Tracking respawn...", 2)
        end
        return
    end
    
    -- NORMÁL TRACKING
    -- Reseting highlight (if new character)
    if TargetPlayer.TargetHighlight and TargetPlayer.TargetHighlight.Adornee ~= char then
        UpdateHighlight(char)
    end
    
    -- CAMERA TRACKING
    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
    
    if onScreen then
        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPos.X - mousePos.X
        local deltaY = screenPos.Y - mousePos.Y
        
        -- Smooth vs Turbo
        if math.abs(deltaX) > 150 or math.abs(deltaY) > 150 then
            mousemoverel(deltaX * 2, deltaY * 2)
        else
            mousemoverel(deltaX * 0.8, deltaY * 0.8)
        end
    else
        -- OFF-SCREEN - big snap
        local dir = (head.Position - Camera.CFrame.Position).Unit
        mousemoverel(dir.X * 800, -dir.Y * 500)
    end
end)

