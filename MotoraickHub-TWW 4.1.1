------------------------------------------------------------
-- PREDICTION MATH HELPERS
------------------------------------------------------------

function SolveTime(origin, speed, targetPos, gravity)
    local diff = targetPos - origin
    local groundDist = Vector3.new(diff.X, 0, diff.Z).Magnitude
    local time = groundDist / speed
    local verticalVelocity = (diff.Y + 0.5 * gravity * time * time) / time
    local horizontalVelocity = Vector3.new(diff.X, 0, diff.Z).Unit * speed
    return Vector3.new(horizontalVelocity.X, verticalVelocity, horizontalVelocity.Z), time
end

function randomVector(rng, axis, angle)
    return (CFrame.new(Vector3.new(), axis) * CFrame.Angles(0, 0, rng:NextNumber(0, 2 * math.pi)) * CFrame.Angles(math.acos(rng:NextNumber(math.cos(angle), 1)), 0, 0)).LookVector
end

function getSpreadVector(seed, direction, spreadAngle)
    local rng = Random.new(seed)
    return direction - (randomVector(rng, direction, spreadAngle) - direction)
end

