------------------------------------------------------------
-- NOTIFY SYSTEM (PLAYERGUI FIX - NO CRASH)
------------------------------------------------------------
local __NotifyCooldown = {}
local __NotifyGui = nil

function Notify(text, duration, isError)
    -- Anti-Spam
    if __NotifyCooldown[text] and tick() - __NotifyCooldown[text] < 1.5 then return end
    __NotifyCooldown[text] = tick()

    -- GUI Creation (Safe for all Executors)
    if not __NotifyGui or not __NotifyGui.Parent then
        __NotifyGui = Instance.new("ScreenGui")
        __NotifyGui.Name = "Motoraick_Notify_Safe"
        __NotifyGui.Parent = PlayerGui -- FIXED: COREGUI HELYETT PLAYERGUI
        __NotifyGui.ResetOnSpawn = false
        __NotifyGui.IgnoreGuiInset = true
    end

    local box = Instance.new("TextLabel")
    box.Parent = __NotifyGui
    box.Size = UDim2.new(0, 200, 0, 24)
    box.Position = UDim2.new(0.02, 0, 0.25, 0) -- Bal oldalt, kicsit lentebb
    box.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    box.BorderSizePixel = 0
    box.Text = " " .. text
    box.Font = Enum.Font.GothamBold
    box.TextSize = 12
    box.TextColor3 = isError and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(100, 255, 100)
    box.BackgroundTransparency = 0.2
    box.TextTransparency = 0
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ZIndex = 10

    if text:find("Horse") then box.TextColor3 = Color3.fromRGB(0, 255, 0) end
    if text:find("MODS") then box.TextColor3 = Color3.fromRGB(0, 255, 255) end

    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    -- Animation stack logic
    for _, child in ipairs(__NotifyGui:GetChildren()) do
        if child:IsA("TextLabel") and child ~= box then
            TweenService:Create(child, TweenInfo.new(0.2), {Position = child.Position + UDim2.new(0, 0, 0, 28)}):Play()
        end
    end

    task.delay(duration or 2.5, function()
        if box and box.Parent then
            TweenService:Create(box, TweenInfo.new(0.3), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
            task.wait(0.3)
            box:Destroy()
        end
    end)
end

