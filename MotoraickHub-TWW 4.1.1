                    if Global.PlayerCharacter.RunSpeed then Global.PlayerCharacter.RunSpeed = 16 * SpeedBypass.SpeedMultiplier end
                    if Global.PlayerCharacter.SprintSpeed then Global.PlayerCharacter.SprintSpeed = 22 * SpeedBypass.SpeedMultiplier end
