function getTWWCharacter(player)
    if not player then return nil end
    if player == LocalPlayer then
        local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
        if entities then
            local pFolder = entities:FindFirstChild("Players")
            if pFolder then
                local char = pFolder:FindFirstChild(player.Name)
                if char then return char end
            end
        end
        return Global.PlayerCharacter.Character or LocalPlayer.Character
    end
    
    if RepCharHandler and RepCharHandler.GetRepChar then
        local repChar = RepCharHandler:GetRepChar(player)
        if repChar and repChar.Model then return repChar.Model end
    end
    
    local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
    if entities then
        local pFolder = entities:FindFirstChild("Players")
        if pFolder then
            local char = pFolder:FindFirstChild(player.Name)
            if char then return char end
        end
    end
    return player.Character
end

function getPlayerEquippedWeapon(char)
    if not char then return nil end
    
    -- WHITELIST - Csak ezeket mutatjuk
    local validWeapons = {
        -- Pistols
        "revolver", "peacemaker", "hammerless", "schofield", "volcanic", "derringer", 
        "navy", "dragoon", "lemat", "cattleman", "colt", "pistol",
        -- Rifles
        "rifle", "springfield", "winchester", "sharps", "henry", "bolt", "lever", 
        "carbine", "repeater", "buffalo", "sniper",
        -- Shotguns if ()don't need delete)
        "shotgun", "doublebarrel", "pump", "coach"
    }
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") then
            local nameLower = child.Name:lower()
            
            -- only shows when the guns valid
            local isValidWeapon = false
            for _, weaponType in ipairs(validWeapons) do
                if nameLower:find(weaponType) then
                    isValidWeapon = true
                    break
                end
            end
            
            if isValidWeapon then
                local weaponName = child.Name
                if weaponName:find("LoadoutItem/") then
                    weaponName = weaponName:gsub("LoadoutItem/", "")
                end
                return weaponName
            end
        end
    end
    return nil
end

function GetPlayerState(player)
    if ReplicatedState and ReplicatedState.GetPlayerState then
        return ReplicatedState:GetPlayerState(player)
    end
    return nil
end

function GetPlayerBounty(player)
    local state = GetPlayerState(player)
    if state and state.State then
        if state.State.Bounty and state.State.Bounty > 0 then return state.State.Bounty end
        if state.State.WantedValue and state.State.WantedValue > 0 then return state.State.WantedValue end
    end
    local char = getTWWCharacter(player)
    if char then
        if char:GetAttribute("Bounty") then return char:GetAttribute("Bounty") end
        local bVal = char:FindFirstChild("Bounty")
        if bVal and bVal:IsA("ValueBase") then return bVal.Value end
    end
    if player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Bounty") then
        return player.leaderstats.Bounty.Value
    end
    return 0
end

function IsProtected(player)
    local state = GetPlayerState(player)
    if state and state.State then
        local status = state.State.ProtectionStatus
        return status == 'Protected' or status == 'OutlawProtected'
    end
    return false
end

-- [HORSE HELPERS]
SelectedHorseId = nil
SelectedHorseName = nil

function GetActiveHorseID()
    if not Global.PlayerData or not Global.PlayerData.Data or not Global.PlayerData.Data.Horses then 
        return nil 
    end
    local horses = {}
    for _, horse in pairs(Global.PlayerData.Data.Horses) do table.insert(horses, horse) end
    table.sort(horses, function(a, b) return (a.Breed or "") < (b.Breed or "") end)
    if #horses > 0 then return horses[1].Id end
    return nil
end

function GetOwnedHorseList()
    local list = {}
    if Global.PlayerData and Global.PlayerData.Data and Global.PlayerData.Data.Horses then
        for _, horse in pairs(Global.PlayerData.Data.Horses) do
            local name = (horse.CustomName and horse.CustomName ~= "" and horse.CustomName) or horse.Name or horse.Breed or tostring(horse.Id)
            table.insert(list, { Name = name, Id = horse.Id, Breed = horse.Breed })
        end
    end
    return list
end

function GetOwnedHorseNames()
    local names = {}
    for _, h in ipairs(GetOwnedHorseList()) do
        table.insert(names, h.Name .. " (" .. tostring(h.Breed or "Horse") .. ")")
    end
    if #names == 0 then table.insert(names, "Default Horse") end
    return names
end

function SummonHorse()
    local horseId = SelectedHorseId or GetActiveHorseID()
    if horseId and Global.Network then
        Global.Network:FireServer("CallAnimal", horseId, Camera.CFrame.LookVector)
        Notify("🐴 Horse Called: " .. tostring(SelectedHorseName or "Default"), 2)
    else
        Notify("No Horse Available to Call", 2)
    end
end

