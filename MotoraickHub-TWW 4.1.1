local AUTOFIND_STATE_FILE = "MotoraickHub/autofind_state.json"

function SaveAutoFindState(enabled)
    pcall(function()
        if makefolder and not isfolder("MotoraickHub") then makefolder("MotoraickHub") end
        if writefile then
            writefile(AUTOFIND_STATE_FILE, game:GetService("HttpService"):JSONEncode({ Enabled = enabled }))
        end
    end)
end

function LoadAutoFindState()
    local enabled = false
    pcall(function()
        if isfile and isfile(AUTOFIND_STATE_FILE) then
            local data = game:GetService("HttpService"):JSONDecode(readfile(AUTOFIND_STATE_FILE))
            if data and data.Enabled == true then
                enabled = true
            end
