    ------------------------------------------------------------
    -- 6.5 FARMER TAB
    ------------------------------------------------------------
    function BuildFarmerTab()
        -- Left groupbox: Auto Farm (path record system)
        local FarmBox = Tabs.Farmer:AddLeftGroupbox('Auto Farm')

        FarmBox:AddToggle('AutoFarmToggle', {
            Text = 'Auto Farm',
            Default = false,
            Callback = function(v)
                v3_isAutoFarming = v
                if v then v3_RunAutoFarm() end
            end
        })

        FarmBox:AddToggle('RecordPathToggle', {
            Text = 'Record Farm Path',
            Default = false,
            Callback = function(v)
                v3_setFarmActive = v
                if not v then v3_lastPointPos, v3_lastFloorPos = nil, nil end
            end
        })

        FarmBox:AddSlider('FarmSpeedSlider', {
            Text = 'Auto Farm Speed',
            Default = 38, Min = 0, Max = 100, Rounding = 0,
            Callback = function(v) v3_farmSpeed = v end
        })

        FarmBox:AddButton({ Text = 'Clear Current Path', Func = function()
            v3_visualFolder:ClearAllChildren()
            v3_savedPathPositions = {}
            v3_lastPointPos, v3_lastFloorPos = nil, nil
            Notify("Farm path cleared", 2)
        end })

        -- Left groupbox 2: Path Manager (Save / Load)
        local PathBox = Tabs.Farmer:AddLeftGroupbox('Path Manager')

        PathBox:AddInput('SavePathInput', {
            Default = '',
            Text = 'Path Name',
            Placeholder = 'Enter path name...',
            Callback = function(v)
                v3_currentPathName = v
            end
        })

        PathBox:AddButton({ Text = 'Save Path', Func = function()
            v3_SavePath(v3_currentPathName)
        end })

        PathBox:AddDropdown('LoadPathDropdown', {
            Values = v3_GetSavedPathNames(),
            Default = '',
            Multi = false,
            Text = 'Saved Paths',
            Callback = function(v)
                v3_selectedPathToLoad = v
            end
        })

        PathBox:AddButton({ Text = 'Load Selected Path', Func = function()
            v3_LoadPath(v3_selectedPathToLoad)
        end })

        PathBox:AddButton({ Text = 'Refresh Path List', Func = function()
            if Options and Options.LoadPathDropdown then
                Options.LoadPathDropdown:SetValues(v3_GetSavedPathNames())
                Notify("Path list refreshed!", 1.5)
            end
        end })

        PathBox:AddButton({ Text = 'Delete Selected Path', Func = function()
            v3_DeletePath(v3_selectedPathToLoad)
        end })

        -- Left groupbox 3: Legendary Animal Hunter (AutoFind & Server Hop)
        local LegBox = Tabs.Farmer:AddLeftGroupbox('Legendary Animal Hunter')
        local savedAutoFind = LoadAutoFindState()
        LegBox:AddToggle('LegAutoFindToggle', {
            Text = 'Auto Find Legendary (Server Hop)',
            Default = savedAutoFind,
            Callback = function(v)
                if v then
                    StartLegendaryAutoHop()
                else
                    StopLegendaryAutoHop()
                end
            end
        })
        LegBox:AddButton({ Text = 'Scan Current Server', Func = function()
            local found = FindLegendaryAnimalsInServer()
            if #found > 0 then
                Notify("🌟 Encontrado: " .. tostring(found[1].Name) .. "!", 6)
                HighlightLegendaryAnimal(found[1].Model, found[1].Name)
            else
                Notify("Nenhum animal lendário neste servidor.", 3)
            end
        end })
        LegBox:AddButton({ Text = 'Stop Server Hop', Func = function()
            StopLegendaryAutoHop()
        end })

        -- Right groupbox: Mine Aura + Ore target selection
        local MineBox = Tabs.Farmer:AddRightGroupbox('Mining')

        MineBox:AddToggle('MineAuraToggle', {
            Text = 'Mine Aura (Standalone)',
            Default = false,
            Callback = function(v) FarmerConfig.MineAura = v end
        })

        MineBox:AddDropdown('MiningModeDropdown', {
            Values = { 'Mine Aura (Instant)', 'Legit Swing (Realistic)' },
            Default = 'Legit Swing (Realistic)',
            Multi = false,
            Text = 'Auto Farm Mining Mode',
            Callback = function(v)
                FarmerConfig.MiningMode = v
            end
        })

        MineBox:AddDropdown('OreTargetDropdown', {
            Values = { 'Coal', 'Copper', 'Zinc', 'CopperVein', 'Silver', 'ZincVein', 'Gold', 'Iron', 'Limestone' },
            Default = { 'Coal', 'Copper', 'Zinc', 'CopperVein', 'Silver', 'ZincVein', 'Gold' },
            Multi = true,
            Text = 'Target Ores',
            Callback = function(sel)
                for k, _ in pairs(v3_oreTargets) do v3_oreTargets[k] = false end
                if type(sel) == "table" then
                    for k, v in pairs(sel) do
                        if type(k) == "string" and v == true then
                            v3_oreTargets[k] = true
                        elseif type(v) == "string" then
                            v3_oreTargets[v] = true
                        end
                    end
                end
            end
        })

        -- Right groupbox 2: Auto Sell (Sell Path System)
        local SellBox = Tabs.Farmer:AddRightGroupbox('Auto Sell')

        SellBox:AddToggle('AutoSellToggle', {
            Text = 'Auto Sell (With Farm / Standalone)',
            Default = true,
            Callback = function(v)
                FarmerConfig.AutoSell = v
                v3_isAutoSelling = v
                if v and not v3_isAutoFarming then
                    v3_RunAutoSell()
                end
            end
        })

        SellBox:AddToggle('RecordSellPathToggle', {
            Text = 'Record Sell Path (Gold/Green)',
            Default = false,
            Callback = function(v)
                v3_setSellActive = v
                if not v then v3_lastSellPointPos, v3_lastSellFloorPos = nil, nil end
            end
        })

        SellBox:AddSlider('SellSpeedSlider', {
            Text = 'Auto Sell Speed',
            Default = 38, Min = 0, Max = 100, Rounding = 0,
            Callback = function(v) v3_sellSpeed = v end
        })

        SellBox:AddButton({ Text = 'Clear Current Sell Path', Func = function()
            v3_sellVisualFolder:ClearAllChildren()
            v3_savedSellPathPositions = {}
            v3_lastSellPointPos, v3_lastSellFloorPos = nil, nil
            Notify("Sell path cleared", 2)
        end })

        SellBox:AddButton({ Text = 'Sell All Loot Now (Manual)', Func = function()
            v3_AutoSellLoot()
            Notify("Sell Loot triggered!", 2)
        end })

        -- Right groupbox 3: Sell Path Manager (Save / Load)
        local SellPathBox = Tabs.Farmer:AddRightGroupbox('Sell Path Manager')

        SellPathBox:AddInput('SaveSellPathInput', {
            Default = '',
            Text = 'Sell Path Name',
            Placeholder = 'Enter sell path name...',
            Callback = function(v)
                v3_currentSellPathName = v
            end
        })

        SellPathBox:AddButton({ Text = 'Save Sell Path', Func = function()
            v3_SaveSellPath(v3_currentSellPathName)
        end })

        SellPathBox:AddDropdown('LoadSellPathDropdown', {
            Values = v3_GetSavedSellPathNames(),
            Default = '',
            Multi = false,
            Text = 'Saved Sell Paths',
            Callback = function(v)
                v3_selectedSellPathToLoad = v
            end
        })

        SellPathBox:AddButton({ Text = 'Load Selected Sell Path', Func = function()
            v3_LoadSellPath(v3_selectedSellPathToLoad)
        end })

        SellPathBox:AddButton({ Text = 'Refresh Sell Path List', Func = function()
            if Options and Options.LoadSellPathDropdown then
                Options.LoadSellPathDropdown:SetValues(v3_GetSavedSellPathNames())
                Notify("Sell path list refreshed!", 1.5)
            end
        end })

        SellPathBox:AddButton({ Text = 'Delete Selected Sell Path', Func = function()
            v3_DeleteSellPath(v3_selectedSellPathToLoad)
        end })

        -- Right groupbox 4: Instant Item & Cash Pickup
        local PickupBox = Tabs.Farmer:AddRightGroupbox('Instant Item & Cash Pickup')
        PickupBox:AddToggle('InstantPickupToggle', {
            Text = 'Instant Item & Cash Pickup',
            Default = false,
            Callback = function(v) InstantPickupConfig.Enabled = v end
        })
        PickupBox:AddSlider('PickupRangeSlider', {
            Text = 'Pickup Range (Studs)',
            Default = 25, Min = 5, Max = 50, Rounding = 0,
            Callback = function(v) InstantPickupConfig.Range = v end
        })
    end

    ------------------------------------------------------------
    -- 7. BUILD ALL TABS
    ------------------------------------------------------------
    function safeBuild(name, fn)
        local ok, err = pcall(fn)
        if not ok then
            warn("[MOTORAICK HUB] Error building " .. name .. ": " .. tostring(err))
        end
    end
    safeBuild("Combat", BuildCombatTab)
    safeBuild("Movement", BuildMovementTab)
    safeBuild("Horse", BuildHorseTab)
    safeBuild("ESP", BuildESPTab)
    safeBuild("Visuals", BuildVisualsTab)
    safeBuild("Farmer", BuildFarmerTab)
    safeBuild("Misc", BuildMiscTab)

    -- Addons & UI Settings
    ThemeManager:SetLibrary(Library)
    SaveManager:SetLibrary(Library)

    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({ 'MenuKeyPicker' })

    ThemeManager:SetFolder('MotoraickHub')
    SaveManager:SetFolder('MotoraickHub/tww')

    SaveManager:BuildConfigSection(Tabs['UI Settings'])
    ThemeManager:ApplyToTab(Tabs['UI Settings'])

    local MenuGroup = Tabs['UI Settings']:AddLeftGroupbox('Menu Keybind')
    MenuGroup:AddLabel('Menu Key'):AddKeyPicker('MenuKeyPicker', { Default = 'Insert', SyncToggleState = false, Mode = 'Toggle', Text = 'Menu Toggle Key' })
    Library.ToggleKeybind = Options.MenuKeyPicker

    print("[MOTORAICK HUB 4.4] LinoriaLib UI Loaded Successfully!")
    Library:Notify("MOTORAICK HUB 4.4 Loaded with LinoriaLib!", 4)
end)()
