local OldLowerStamina = Global.PlayerCharacter.LowerStamina
local OldRagdoll = Global.PlayerCharacter.Ragdoll
local OldFireServer = Global.Network.FireServer
local tpProjectiles = {}

function HandleProjectileTP(data)
    task.wait(data.time)
    for _, bulletId in pairs(data.bullets) do
        local targetRef = nil
        if data.player then
            targetRef = Global.Network:GetReference(data.target, 'CharacterPart')
        elseif data.npc then
            local npcFolder = GetNPCFolder(data.target)
            targetRef = {
                npcFolder or data.target.Parent.Parent,
                data.target.Name
            }
        elseif data.animal then
            targetRef = data.target
        end

        if not data.player or targetRef then
            OldFireServer(Global.Network, 'ProjectileEvent', bulletId, Global.SyncedTime:GetTime(), 'Final', targetRef, data.cframe:PointToObjectSpace(data.hitPos), data.cframe:VectorToObjectSpace(Vector3.FromNormalId(Enum.NormalId.Front)), data.cframe:VectorToObjectSpace(data.velocity.Unit), data.hitPos, Vector3.FromNormalId(Enum.NormalId.Front), data.target.Material.Name)
            task.defer(OldFireServer, Global.Network, 'RemoveProjectile', bulletId)
            tpProjectiles[bulletId] = nil
        end
    end
end

Global.Network.FireServer = function(self, Remote, ...)
    local args = {...}

    if HideErrors then
        if Remote == "ItemError" or Remote == "ProjectileError" or Remote == "EffectorError" then 
            return 
        end
    end

    if Remote == "InitProjectiles" then
        local weapon = Global.PlayerCharacter:GetEquippedItem(); local packet = args[2]; local bulletIds = args[3]
        if type(weapon) == "table" and type(packet) == "table" then
             local shared = weapon.SharedData; local wName = (debug.getstack(3) or {})[2]
             if SilentAim.Enabled then
                local targetPart = SilentAim.Target
                if targetPart and math.random(1, 100) <= SilentAim.HitChance then
                    local projectileSpeed = (wName == 'TomahawkProjectile') and 200 or shared.ProjectilePower
                    local gravity = (wName == 'TomahawkProjectile') and Vector3.new(0, -150, 0) or (shared.Gravity or Vector3.new(0, -32, 0))
                    if type(shared.GravityMultiplier) == 'number' then gravity = gravity * shared.GravityMultiplier end
                    if type(packet.power) == 'number' and type(packet.drawStart) == 'number' then local pwr = math.min(packet.power, 1); projectileSpeed = (packet.arrowType ~= 'ExplosiveArrow') and math.min(shared.MinPower, pwr) or math.max(shared.MaxPower, pwr) end
                    local solvedVelocity, flightTime = SolveTime(packet.origin, projectileSpeed, targetPart.Position, math.abs(gravity.Y))
                    if solvedVelocity then
                         local unit = solvedVelocity.Unit; local acc = shared.ProjectileAccuracy or 1
                         if packet.ammoType == 'ShotgunRound' then acc = acc * (shared.ShotgunRoundAccuracy or 1) end
                         local spreadAngle = ((shared.NumProjectiles or 1) > 1 and math.rad(10) or math.rad(12.5)) * math.clamp(1 - acc, 0, 1)
                         if wName == 'TomahawkProjectile' or wName == 'ArrowProjectile' or (packet.ammoType and tostring(packet.ammoType):find('Arrow')) then
                             if wName == 'ArrowProjectile' or (packet.ammoType and tostring(packet.ammoType):find('Arrow')) then
                                 local targetPos = targetPart.Position
                                 local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
                                 local dist = (targetPos - packet.origin).Magnitude
                                 local arrowSpeed = 250
                                 local flightTime = dist / arrowSpeed
                                 local predictedPos = targetPos + (vel * flightTime) + Vector3.new(0, 0.5 * 32 * flightTime * flightTime, 0)
                                 packet.direction = (predictedPos - packet.origin).Unit
                                 packet.power = 1
                                 packet.accuracy = 1
                             else
                                 packet.direction = unit
                             end
                         else
                             packet.direction = getSpreadVector(packet.seed, unit, spreadAngle); packet.accuracy = 1
                         end
                         if type(packet.power) == 'number' and type(packet.drawStart) ~= 'number' then packet.power = 1 end
                         if ProjectileTP.Enabled and wName ~= 'ArrowProjectile' and not (packet.ammoType and tostring(packet.ammoType):find('Arrow')) then
                             local _, hitPos = Workspace:FindPartOnRayWithWhitelist(Ray.new(packet.origin, targetPart.Position - packet.origin), {targetPart})
                             OldFireServer(self, Remote, unpack(args))
                             local isPlayer = false
                             local isAnimal = false
                             local isNpc = false
                             local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
                             if entities then
                                 if entities:FindFirstChild("Animals") and targetPart:IsDescendantOf(entities.Animals) then
                                     isAnimal = true
                                 elseif entities:FindFirstChild("NPCs") and targetPart:IsDescendantOf(entities.NPCs) then
                                     isNpc = true
                                 end
                             end
                             if not isAnimal and not isNpc then
                                 for _, p in ipairs(Players:GetPlayers()) do
                                     local char = getTWWCharacter(p)
                                     if char and targetPart:IsDescendantOf(char) then
                                         isPlayer = true
                                         break
                                     end
                                 end
                             end
                             if type(bulletIds) == "table" then for _, id in pairs(bulletIds) do tpProjectiles[id] = true end end
                             task.spawn(HandleProjectileTP, {cframe = targetPart.CFrame, hitPos = hitPos or targetPart.Position, player = isPlayer, animal = isAnimal, npc = isNpc, origin = packet.origin, direction = unit, speed = projectileSpeed, velocity = unit * projectileSpeed, time = flightTime, target = targetPart, bullets = bulletIds})
                             return
                         end
                    end
                end
             end
             if not SilentAim.Enabled and AntigravityState.noSpreadEnabled and (wName ~= 'TomahawkProjectile' and wName ~= 'ArrowProjectile') then
                 local acc = shared.ProjectileAccuracy or 1; if packet.ammoType == 'ShotgunRound' then acc = acc * (shared.ShotgunRoundAccuracy or 1) end
                 local spreadAngle = ((shared.NumProjectiles or 1) > 1 and math.rad(10) or math.rad(12.5)) * math.clamp(1 - acc, 0, 1)
                 packet.accuracy = 1; packet.direction = getSpreadVector(packet.seed, packet.direction, spreadAngle)
             end
        end
    end
    if Remote == "ThrowLasso" and SilentAim.Enabled and (SilentAim.LassoAim ~= false) then
        local targetPart = SilentAim.Target
        if targetPart and math.random(1, 100) <= SilentAim.HitChance then
            local rightHand = Global.PlayerCharacter and Global.PlayerCharacter.Character and Global.PlayerCharacter.Character:FindFirstChild("RightHand")
            local origin = rightHand and rightHand.Position or Camera.CFrame.Position
            local targetPos = targetPart.Position
            local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
            local dist = (targetPos - origin).Magnitude
            local flightTime = dist / 120
            local predictedPos = targetPos + (vel * flightTime)
            local dir = (predictedPos - origin).Unit
            local speed = 120
            args[3] = dir * speed

            local equipped = Global.PlayerCharacter:GetEquippedItem()
            if equipped and equipped.LassoCircle and equipped.LassoCircle:FindFirstChild("BodyGyro") then
                pcall(function()
                    equipped.LassoCircle.BodyGyro.CFrame = CFrame.new(equipped.LassoCircle.Position, predictedPos)
                    equipped.LassoCircle.Velocity = (dir * speed) + (Global.ClientPlatforms:GetSelfVelocity() or Vector3.zero)
                end)
            end
        end
    end
    if Remote == 'ProjectileEvent' or Remote == 'RemoveProjectile' then if args[1] and tpProjectiles[args[1]] then return end end
    if AntigravityState.FlyEnabled and Remote == "CharUpdate" then return end
    if InvisibleBypass.Enabled and (Remote == "DamageSelf" or Remote == "CharUpdate") then return end
    if CharacterFeatures.InfStamina and (Remote == "ACRoll" or Remote == "LowerStamina") then return end
    if CharacterFeatures.NoFallDamage and (Remote == "DamageSelf" or Remote == "TrainSmack") then return end
    return OldFireServer(self, Remote, unpack(args))
end

Global.PlayerCharacter.LowerStamina = function(...) if CharacterFeatures.InfStamina then return end return OldLowerStamina(...) end
Global.PlayerCharacter.Ragdoll = function(...) if InvisibleBypass.Enabled or CharacterFeatures.NoRagdoll then return end return OldRagdoll(...) end

