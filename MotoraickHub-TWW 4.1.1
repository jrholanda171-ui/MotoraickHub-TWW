    end)
    return enabled
end

local LEGENDARY_ANIMAL_NAMES = {
    "legendary", "grizzly", "white moose", "golden bull",
    "demon gator", "albino", "great bear", "phantom bison",
    "spectral wolf", "black stag", "giant bear", "white stag"
}

function IsLegendaryAnimal(model)
    if not model or not (model:IsA("Model") or model:IsA("Folder")) then return false end
    local n = model.Name:lower()
    
    -- Exclude horses, mules, donkeys, wagons, or ridden mounts
    if n:find("horse") or n:find("mule") or n:find("donkey") or n:find("wagon") then
        return false
    end
    local rider = model:FindFirstChild("Rider")
    if rider and rider:IsA("ValueBase") and rider.Value ~= nil then return false end
    local pass = model:FindFirstChild("PassengerValue")
    if pass and pass:IsA("ValueBase") and pass.Value ~= nil then return false end
    
    -- 1. Exact ESP Attribute check (Any truthy value on "Legendary")
    local legAttr = model:GetAttribute("Legendary")
    if legAttr ~= nil and legAttr ~= false then
        return true, "★ LEGENDARY " .. model.Name
    end
    local isLegAttr = model:GetAttribute("IsLegendary")
    if isLegAttr ~= nil and isLegAttr ~= false then
        return true, "★ LEGENDARY " .. model.Name
    end
    local variant = model:GetAttribute("Variant") or model:GetAttribute("AnimalVariant") or model:GetAttribute("Type")
    if variant and tostring(variant):lower():find("legendary") then
        return true, "★ LEGENDARY " .. model.Name
    end

    -- 2. CollectionService Tags (Thunderstruck / Legendary)
    local hasCsTag = false
    pcall(function()
        local cs = game:GetService("CollectionService")
        if cs:HasTag(model, "Legendary") or cs:HasTag(model, "Thunderstruck") then
            hasCsTag = true
        end
    end)
    if hasCsTag then
        return true, "★ LEGENDARY " .. model.Name
    end

    -- 3. Pre-existing ESP tags on model (LegendaryTag / ThunderTag)
    if model:FindFirstChild("LegendaryTag", true) or model:FindFirstChild("ThunderTag", true) then
        return true, "★ LEGENDARY " .. model.Name
    end

    -- 4. Wendigo Mob
    if n == "wendigo" or (n:find("wendigo") and not n:find("horse")) then
        return true, "★ WENDIGO (" .. model.Name .. ")"
    end

    -- 5. Substring / name matches
    for _, leg in ipairs(LEGENDARY_ANIMAL_NAMES) do
        if n:find(leg) then return true, "★ LEGENDARY " .. model.Name end
    end

    -- 6. Children / Value Objects
    local info = model:FindFirstChild("AnimalInfo") or model:FindFirstChild("DepositInfo") or model:FindFirstChild("Info")
    if info then
        if info:FindFirstChild("Legendary") or info:FindFirstChild("IsLegendary") then
            return true, "★ LEGENDARY " .. model.Name
        end
        if info:GetAttribute("Legendary") or info:GetAttribute("IsLegendary") then
            return true, "★ LEGENDARY " .. model.Name
        end
    end
    return false
end

function FindLegendaryAnimalsInServer()
    local found = {}
    local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
    local animals = entities and entities:FindFirstChild("Animals")
    if animals then
        for _, anim in ipairs(animals:GetChildren()) do
            local isLeg, legName = IsLegendaryAnimal(anim)
            if isLeg then
                local part = anim.PrimaryPart or anim:FindFirstChildWhichIsA("BasePart") or anim:FindFirstChild("HumanoidRootPart") or anim:FindFirstChild("Hitbox")
                table.insert(found, { Model = anim, Name = legName, Part = part })
            end
        end
    end
    -- Also check CollectionService tagged animals directly
    pcall(function()
        local cs = game:GetService("CollectionService")
        for _, m in pairs(cs:GetTagged("Thunderstruck")) do
            if m and m.Parent and not m.Name:lower():find("horse") then
                local part = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                table.insert(found, { Model = m, Name = "★ THUNDERSTRUCK " .. m.Name, Part = part })
            end
        end
        for _, m in pairs(cs:GetTagged("Legendary")) do
            if m and m.Parent and not m.Name:lower():find("horse") then
                local part = m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
                table.insert(found, { Model = m, Name = "★ LEGENDARY " .. m.Name, Part = part })
            end
        end
    end)
    -- Also check NPCs for Wendigo
    if entities then
        local npcs = entities:FindFirstChild("NPCs")
        if npcs then
            for _, npc in ipairs(npcs:GetChildren()) do
                if npc.Name:lower():find("wendigo") and not npc.Name:lower():find("horse") then
                    local part = npc.PrimaryPart or npc:FindFirstChildWhichIsA("BasePart")
                    table.insert(found, { Model = npc, Name = "★ WENDIGO", Part = part })
                end
            end
        end
    end
    return found
end

function HighlightLegendaryAnimal(model, name)
    if not model then return end
