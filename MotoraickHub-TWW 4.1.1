function IsAlive(model) if not model then return false end local hum = model:FindFirstChild("Humanoid"); return hum and hum.Health > 0 end
function IsPlayerVisible(targetPart)
    if not SilentAim.WallCheck then return true end
    local origin = Camera.CFrame.Position; local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = { getTWWCharacter(LocalPlayer), Workspace.CurrentCamera, Workspace:FindFirstChild("Ignore"), Workspace:FindFirstChild("Projectiles") }
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude; raycastParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result and result.Instance then return result.Instance:IsDescendantOf(targetPart.Parent) end
    return true 
end

function GetClosestTarget()
    local closest = nil
    local closestDist = SilentAim.FOV
    local mousePos = UserInputService:GetMouseLocation()
    
    local function checkTarget(part)
        if not part then return end
        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
            if dist < closestDist then
                local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                if worldDist <= SilentAim.MaxDistance then
                    if IsPlayerVisible(part) then
                        closestDist = dist
                        closest = part
                    end
                end
            end
        end
    end

    -- 1. PLAYERS
    if SilentAim.Focus.Players then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if SilentAim.ProtectionCheck and IsProtected(p) then continue end
                local char = getTWWCharacter(p)
                if IsAlive(char) then
                    local hp, _ = GetHealthTWW(p, char)
                    if SilentAim.DeadCheck and hp <= 0 then continue end
                    local hitPart = char:FindFirstChild(SilentAim.HitPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                    checkTarget(hitPart)
                end
            end
        end
    end

    -- 2. ANIMALS
    if SilentAim.Focus.Animals then
        local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
        local animals = entities and entities:FindFirstChild("Animals")
        if animals then
            for _, anim in ipairs(animals:GetChildren()) do
                local health = GetAnimalHealth(anim)
                if health > 0 then
                    local root = GetAnimalRoot(anim)
                    local hitPart = anim:FindFirstChild(SilentAim.HitPart) or root
                    checkTarget(hitPart)
                end
            end
        end
    end

    -- 3. NPCS
    if SilentAim.Focus.NPCs then
        local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
        local npcs = entities and entities:FindFirstChild("NPCs")
        if npcs then
            for _, npc in ipairs(npcs:GetChildren()) do
                local root = GetNPCRoot(npc)
                if not root then continue end
                local health = GetNPCHealth(npc)
                if health <= 0 then continue end
                local rig = GetNPCRig(npc)
                local hitPart = rig and (rig:FindFirstChild(SilentAim.HitPart) or rig:FindFirstChild("Head")) or root
                checkTarget(hitPart)
            end
        end
    end

    return closest
end

