    task.wait(3.5)
    if LoadAutoFindState() or _G.AutoFindLegendary then
        if Toggles and Toggles.LegAutoFindToggle then
            Toggles.LegAutoFindToggle:SetValue(true)
        else
            StartLegendaryAutoHop()
        end
    end
end)

