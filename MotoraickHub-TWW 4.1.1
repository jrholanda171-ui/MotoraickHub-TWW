function UpdateWeaponStats()
    if not SharedData or not SharedData.PlayerItemTypes then return end
    for itemName, categoryData in pairs(SharedData.PlayerItemTypes) do
        if categoryData.Items then
            for itemId, itemStats in pairs(categoryData.Items) do
                if not AntigravityState.WeaponStatsBackup[itemId] then
                    AntigravityState.WeaponStatsBackup[itemId] = {
                        Recoil = itemStats.BaseRecoil,
                        ProjAcc = itemStats.ProjectileAccuracy,
                        FanAcc = itemStats.FanAccuracy,
                        Penetration = itemStats.ProjectilePenetration,
                        EquipTime = itemStats.EquipTime,
                        HolsterTime = itemStats.HolsterTime,
                        PreEquipTime = itemStats.PreEquipTime,
                        EquipAnim = itemStats.EquipAnimSpeed
                    }
                end
                local original = AntigravityState.WeaponStatsBackup[itemId]
                if itemStats.BaseRecoil ~= nil then itemStats.BaseRecoil = AntigravityState.noRecoilEnabled and AntigravityState.recoilValue or original.Recoil end
                if itemStats.ProjectileAccuracy ~= nil then itemStats.ProjectileAccuracy = original.ProjAcc end
                if itemStats.ProjectilePenetration ~= nil then itemStats.ProjectilePenetration = original.Penetration end
                
                if AntigravityState.instantEquipEnabled then
                    itemStats.EquipTime = 0; itemStats.HolsterTime = 0; itemStats.PreEquipTime = 0; itemStats.EquipAnimSpeed = 50
                else
                    itemStats.EquipTime = original.EquipTime; itemStats.HolsterTime = original.HolsterTime; itemStats.PreEquipTime = original.PreEquipTime; itemStats.EquipAnimSpeed = original.EquipAnim
                end
            end
        end
    end
end

if Holsters and Holsters.GetEquippingSpeed then
    AntigravityState.originalHolsterFunc = Holsters.GetEquippingSpeed
    function Holsters:GetEquippingSpeed() 
        if AntigravityState.instantEquipEnabled then return math.huge end 
        if AntigravityState.originalHolsterFunc then return AntigravityState.originalHolsterFunc(self) end
        return 1
    end
end

function ToggleInstantShoot(state)
    AntigravityState.instantShootEnabled = state
    for i, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "CanShoot") and type(v.CanShoot) == "function" then
            if state then
                if not AntigravityState.originalCanShoot[v] then AntigravityState.originalCanShoot[v] = v.CanShoot end
                v.CanShoot = function(...) return true end
            else
                if AntigravityState.originalCanShoot[v] then v.CanShoot = AntigravityState.originalCanShoot[v] AntigravityState.originalCanShoot[v] = nil end
            end
        end
    end
end

RunService.Heartbeat:Connect(function() if AntigravityState.instantEquipEnabled or AntigravityState.noRecoilEnabled then UpdateWeaponStats() end end)

task.spawn(function()
    while true do
        if AntigravityState.infiniteAmmoEnabled then
            local char = Global.PlayerCharacter
            if char then
                local gun = char:GetEquippedItem()
                if gun and gun.IsGunItem then
                    if gun.Ammo and gun.MaxAmmo then gun.Ammo = gun.MaxAmmo end
                    if gun.HasChamber and gun.State and gun.State.ChamberData and gun.State.ChamberData.bullets then 
                        for i = 1, #gun.State.ChamberData.bullets do gun.State.ChamberData.bullets[i] = "unused" end 
                    end
                end
            end
        end
        if not AntigravityState.instantEquipEnabled and not AntigravityState.noRecoilEnabled then UpdateWeaponStats() end
        task.wait(0.5)
    end
end)

