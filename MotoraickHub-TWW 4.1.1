local NoclipParts = {}
function CacheCharacterParts(char)
    table.clear(NoclipParts)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(NoclipParts, part)
        end
    end
end

function AntigravityState.ToggleNoclip(enable)
    AntigravityState.NoclipEnabled = enable
    if enable then
        if AntigravityState.NoclipConnection then AntigravityState.NoclipConnection:Disconnect() end
        local char = getTWWCharacter(LocalPlayer)
        CacheCharacterParts(char)
        
        if AntigravityState.NoclipCharConn then AntigravityState.NoclipCharConn:Disconnect() end
        AntigravityState.NoclipCharConn = LocalPlayer.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            CacheCharacterParts(newChar)
        end)
        
        AntigravityState.NoclipConnection = RunService.Stepped:Connect(function()
            for _, part in ipairs(NoclipParts) do
                if part.Parent then
                    part.CanCollide = false
                end
            end
        end)
    else
        if AntigravityState.NoclipConnection then
            AntigravityState.NoclipConnection:Disconnect()
            AntigravityState.NoclipConnection = nil
        end
        if AntigravityState.NoclipCharConn then
            AntigravityState.NoclipCharConn:Disconnect()
            AntigravityState.NoclipCharConn = nil
        end
        table.clear(NoclipParts)
    end
end

