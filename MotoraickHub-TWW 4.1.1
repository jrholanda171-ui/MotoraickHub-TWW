function EnableTrail(part, color)
    if not part then return end
    local att0 = part:FindFirstChild("TrailAtt0"); local att1 = part:FindFirstChild("TrailAtt1"); local trail = part:FindFirstChild("Motoraick_Trail")
    if not trail then
        att0 = Instance.new("Attachment", part); att0.Name = "TrailAtt0"; att1 = Instance.new("Attachment", part); att1.Name = "TrailAtt1"
        local size = part.Size
        if size.Z > size.Y and size.Z > size.X then att0.Position = Vector3.new(0, 0, -size.Z/2); att1.Position = Vector3.new(0, 0, size.Z/2) else att0.Position = Vector3.new(0, -size.Y/2, 0); att1.Position = Vector3.new(0, size.Y/2, 0) end
        trail = Instance.new("Trail", part); trail.Name = "Motoraick_Trail"; trail.Attachment0 = att0; trail.Attachment1 = att1; trail.FaceCamera = true; trail.LightEmission = 1; trail.MinLength = 0.1; trail.Transparency = NumberSequence.new(0.3, 1)
    end
    trail.Enabled = true; trail.Lifetime = trailLifetime; trail.Color = ColorSequence.new(color); trail.WidthScale = NumberSequence.new(trailSize, 0)
end

local LastEquippedWeapon = nil
function updateWeaponEffects()
    local char = getTWWCharacter(LocalPlayer)
    if not char then return end
    
    local weaponName = getPlayerEquippedWeapon(char)
    local weaponModel = weaponName and char:FindFirstChild(weaponName)
    
    -- If no effects are enabled, we only need to restore if we still have a LastEquippedWeapon cached
    local effectsEnabled = (ghostEnabled or sizeEnabled or weaponRainbowEnabled or trailEnabled)
    if not effectsEnabled then
        if LastEquippedWeapon then
            if LastEquippedWeapon.Parent then
                pcall(function()
                    for _, part in ipairs(LastEquippedWeapon:GetDescendants()) do
                        if part:IsA("BasePart") or part:IsA("MeshPart") then
                            local orig = part:GetAttribute("OriginalSize")
                            if orig then part.Size = orig end
                            local trail = part:FindFirstChild("Motoraick_Trail")
                            if trail then trail:Destroy() end
                        end
                    end
                end)
            end
            LastEquippedWeapon = nil
        end
        return
    end
    
    if weaponModel ~= LastEquippedWeapon then
        if LastEquippedWeapon and LastEquippedWeapon.Parent then
            pcall(function()
                for _, part in ipairs(LastEquippedWeapon:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("MeshPart") then
                        local orig = part:GetAttribute("OriginalSize")
                        if orig then part.Size = orig end
                        local trail = part:FindFirstChild("Motoraick_Trail")
                        if trail then trail:Destroy() end
                    end
                end
            end)
        end
        LastEquippedWeapon = weaponModel
        
        if weaponModel then
            pcall(function()
                for _, part in ipairs(weaponModel:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("MeshPart") then
                        if not part:GetAttribute("OriginalSize") then
                            part:SetAttribute("OriginalSize", part.Size)
                        end
                        if sizeEnabled then
                            local orig = part:GetAttribute("OriginalSize")
                            if orig then part.Size = orig * scaleFactor end
                        end
                        if ghostEnabled then
                            part.Transparency = transparency
                            part.Material = Enum.Material.ForceField
                        end
                        if trailEnabled then
                            EnableTrail(part, weaponColor)
                        end
                    end
                end
            end)
        end
    end
    
    if weaponModel and weaponRainbowEnabled then
        local h = (tick() * rainbowCycleSpeed) % 1
        local currentColor = Color3.fromHSV(h, 1, 1)
        pcall(function()
            for _, part in ipairs(weaponModel:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("MeshPart") then
                    if ghostEnabled then part.Color = currentColor end
                    local trail = part:FindFirstChild("Motoraick_Trail")
                    if trail and trailEnabled and trailRainbow then
                        trail.Color = ColorSequence.new(currentColor)
                    end
                end
            end
        end)
    end
end

function ForceWeaponEffectsUpdate()
    LastEquippedWeapon = nil
end
AntigravityState.ForceWeaponEffectsUpdate = ForceWeaponEffectsUpdate

