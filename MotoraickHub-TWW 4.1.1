function GetAnimHandler()
    if Global and Global.PlayerCharacter and Global.PlayerCharacter.AnimationHandler then
        return Global.PlayerCharacter.AnimationHandler
    end
    return nil
end

Animations = Animations or {}
Animations.Selected = Animations.Selected or {}      -- kiválasztott animok: [name] = true/false
Animations.SpamDelay = Animations.SpamDelay or 0    -- 0 = Heartbeat ULTRA spam
Animations.LoopEnabled = Animations.LoopEnabled or false
Animations.Running = Animations.Running or false
Animations.SpamConnection = Animations.SpamConnection or nil
Animations.Buttons = Animations.Buttons or {}       -- UI gomb cache

function StopAllTracks(fadeOut)
    local handler = GetAnimHandler()
    if handler and handler.StopAllTracks then
        pcall(function() handler:StopAllTracks(fadeOut or 0.1) end)
    else
        local char = getTWWCharacter(LocalPlayer)
        if char and char:FindFirstChild("Humanoid") then
            local animator = char.Humanoid:FindFirstChild("Animator")
            if animator then
                for _, track in pairs(animator:GetPlayingAnimationTracks()) do
                    track:Stop(fadeOut or 0.1)
                end
            end
        end
    end
end

function StopSpamConnection()
    if Animations.SpamConnection then
        if typeof(Animations.SpamConnection) == "RBXScriptConnection" then
            Animations.SpamConnection:Disconnect()
        else
            pcall(function() task.cancel(Animations.SpamConnection) end)
        end
        Animations.SpamConnection = nil
    end
end

function PlaySelectedOnce()
    local handler = GetAnimHandler()
    if not handler then
        Notify("Anim Handler Not Found", 2, true)
        return
    end

    if not next(Animations.Selected) then
        Notify("No Animations Selected", 2, true)
        return
    end

    StopAllTracks(0.05)

    for name, enabled in pairs(Animations.Selected) do
        if enabled then
            pcall(function()
                handler:PlayTrack(name, 0.1, 1, 1)
            end)
        end
    end
end

function SetupSpamConnection()
    StopSpamConnection()

    if not Animations.LoopEnabled or not Animations.Running or not next(Animations.Selected) then
        return
    end

    function playAll()
        local handler = GetAnimHandler()
        if not handler then return end
        for name, enabled in pairs(Animations.Selected) do
            if enabled then
                pcall(function()
                    handler:PlayTrack(name, 0, 1, 1)
                end)
            end
        end
    end

    local delay = Animations.SpamDelay or 0
    delay = math.max(0, delay)

    if delay == 0 then
        -- ULTRA SPAM minden frame-en (Heartbeat)
        Animations.SpamConnection = RunService.Heartbeat:Connect(function()
            if not Animations.LoopEnabled or not Animations.Running or not next(Animations.Selected) then
                StopSpamConnection()
                return
            end
            playAll()
        end)
    else
        -- Delay alapú spam
        Animations.SpamConnection = task.spawn(function()
            while Animations.LoopEnabled and Animations.Running and next(Animations.Selected) do
                playAll()
                local d = Animations.SpamDelay or delay
                if d < 0 then d = 0 end
                task.wait(d)
            end
            StopSpamConnection()
        end)
    end
end

function StartSelectedAnimations()
    if not next(Animations.Selected) then
        Notify("No Animations Selected", 2, true)
        return
    end

    if Animations.LoopEnabled then
        Animations.Running = true
        SetupSpamConnection()
        if Animations.SpamDelay == 0 then
            Notify("ULTRA SPAM running", 2)
        else
            Notify("Spamming animations", 2)
        end
    else
        PlaySelectedOnce()
    end
end

function StopAllAnimations()
    Animations.Running = false
    StopSpamConnection()
    StopAllTracks(0.1)
end

-- kompatibilitás: ha valahol régi PlayTrack hívás van, csak hozzáad a listához
function PlayTrack(trackName)
    Animations.Selected[trackName] = true
    if Animations.Buttons and Animations.Buttons[trackName] then
        local btn = Animations.Buttons[trackName]
        btn.BackgroundColor3 = Config.Theme.Error
        btn.TextColor3 = Config.Theme.Primary
    end
end


-- [V3 Farmer Helper Functions]
function v3_GetActiveOres()
    local ores = {}
    local mining = Workspace:FindFirstChild("WORKSPACE_Interactables")
        and Workspace.WORKSPACE_Interactables:FindFirstChild("Mining")
        and Workspace.WORKSPACE_Interactables.Mining:FindFirstChild("OreDeposits")
    if mining then
        for _, oreFolder in pairs(mining:GetChildren()) do
            local currentCategory = oreFolder.Name
            for _, model in pairs(oreFolder:GetChildren()) do
                if model:IsA("Model") then
                    local info = model:FindFirstChild("DepositInfo")
                    local rem = info and info:FindFirstChild("OreRemaining")
                    local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart") or info
                    if rem and part and rem.Value > 0 then
                        table.insert(ores, { Model = model, Remaining = rem, Part = part, OreCategory = currentCategory })
                    end
                end
            end
        end
    end
    return ores
end

function v3_GetFloor(pos, char)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, v3_visualFolder}
    local result = Workspace:Raycast(pos + Vector3.new(0, 5, 0), Vector3.new(0, -25, 0), params)
    return result and (result.Position + Vector3.new(0, 0.1, 0)) or pos
end

function v3_CreatePoint(floorPos)
    local part = Instance.new("Part", v3_visualFolder)
    part.Size = Vector3.new(0.35, 0.35, 0.35)
    part.Shape = Enum.PartType.Ball
    part.Color = Color3.fromRGB(255, 255, 255)
    part.Material = Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.Position = floorPos
end

function v3_DrawLine(posA, posB)
    local distance = (posA - posB).Magnitude
    if distance < 0.1 then return end
    local line = Instance.new("Part", v3_visualFolder)
    line.Size = Vector3.new(0.15, 0.15, distance)
    line.Color = Color3.fromRGB(0, 255, 255)
    line.Material = Enum.Material.Neon
    line.Anchored = true
    line.CanCollide = false
    line.CFrame = CFrame.new(posA:Lerp(posB, 0.5), posB)
end

