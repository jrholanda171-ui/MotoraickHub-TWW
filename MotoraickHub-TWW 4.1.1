function CreateDrawing(type, props)
    if not DrawingAvailable then return nil end
    local d = Drawing.new(type)
    for k, v in pairs(props) do d[k] = v end
    return d
end

function GetHealthTWW(player, character)
    if RepCharHandler and RepCharHandler.GetRepChar then
        local repChar = RepCharHandler:GetRepChar(player)
        if repChar and repChar.State then
            local hp = repChar.State.Health
            local max = repChar.State.MaxHealth or 100
            if repChar.State.IsDead or repChar.State.Downed then return 0, max end
            if hp ~= nil then return hp, max end
        end
    end
    if RepCharHandler and RepCharHandler.CharacterMap then
        local charData = RepCharHandler.CharacterMap[player.Name]
        if charData and charData.State then
            local hp = charData.State.Health
            local max = charData.State.MaxHealth or 100
             if charData.State.IsDead or charData.State.Downed then return 0, max end
            if hp ~= nil then return hp, max end
        end
    end
    local hum = character:FindFirstChild("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

