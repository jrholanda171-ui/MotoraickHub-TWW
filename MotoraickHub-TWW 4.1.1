function AntigravityState.SetupAutoBreakFree(enable)
    CharacterFeatures.AutoBreakFree = enable
    if enable and not AntigravityState.AutoBreakFreeHooked then
        AntigravityState.AutoBreakFreeHooked = true
        task.spawn(function()
            while not Global.PlayerCharacter do task.wait() end
            local realBFP = Global.PlayerCharacter.BreakFreePerc
            
            pcall(function()
                local oldMT = (getrawmetatable and getrawmetatable(Global.PlayerCharacter)) or (debug.getmetatable and debug.getmetatable(Global.PlayerCharacter)) or getmetatable(Global.PlayerCharacter)
                local newMT = {}
                if oldMT then
                    for k, v in pairs(oldMT) do
                        newMT[k] = v
                    end
                end
                
                local original_index = oldMT and oldMT.__index
                newMT.__index = function(t, key)
                    if key == "BreakFreePerc" then return realBFP end
                    if type(original_index) == "function" then
                        return original_index(t, key)
                    elseif type(original_index) == "table" then
                        return original_index[key]
                    end
                    return rawget(t, key)
                end
                
                local original_newindex = oldMT and oldMT.__newindex
                newMT.__newindex = function(t, key, val)
                    if key == "BreakFreePerc" then
                        realBFP = val
                        if CharacterFeatures.AutoBreakFree and type(val) == "number" and val > 0 then realBFP = 1 end
                        return
                    end
                    if type(original_newindex) == "function" then
                        original_newindex(t, key, val)
                    elseif type(original_newindex) == "table" then
                        original_newindex[key] = val
                    else
                        rawset(t, key, val)
                    end
                end
                
                setmetatable(Global.PlayerCharacter, newMT)
            end)
            
            Global.PlayerCharacter.BreakFreePerc = nil
        end)
    end
end

