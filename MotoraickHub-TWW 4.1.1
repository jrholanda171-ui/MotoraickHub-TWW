    part.Material = Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.Position = floorPos
end

function v3_DrawSellLine(posA, posB)
    local distance = (posA - posB).Magnitude
    if distance < 0.1 then return end
    local line = Instance.new("Part", v3_sellVisualFolder)
    line.Size = Vector3.new(0.15, 0.15, distance)
    line.Color = Color3.fromRGB(0, 255, 100) -- Green / Verde
    line.Material = Enum.Material.Neon
    line.Anchored = true
    line.CanCollide = false
    line.CFrame = CFrame.new(posA:Lerp(posB, 0.5), posB)
end

v3_SELL_PATHS_FOLDER = "MOTORAICK_HUB/SellPaths"

function v3_EnsureSellPathFolder()
    pcall(function()
        if not isfolder(v3_SELL_PATHS_FOLDER) then
            makefolder("MOTORAICK_HUB")
            makefolder(v3_SELL_PATHS_FOLDER)
        end
    end)
end

function v3_SaveSellPath(name)
    if not name or name == "" then
        Notify("Please enter a sell path name!", 2, true)
        return
    end
    if #v3_savedSellPathPositions == 0 then
        Notify("No sell path recorded to save!", 2, true)
        return
    end
    v3_EnsureSellPathFolder()
    local data = {}
    for _, pos in ipairs(v3_savedSellPathPositions) do
        table.insert(data, {x = pos.X, y = pos.Y, z = pos.Z})
    end
    local json = game:GetService("HttpService"):JSONEncode(data)
    local ok, err = pcall(function()
        writefile(v3_SELL_PATHS_FOLDER .. "/" .. name .. ".json", json)
    end)
    if ok then
        Notify("Sell Path '" .. name .. "' saved! (" .. #data .. " points)", 3)
        if Options and Options.LoadSellPathDropdown then
            Options.LoadSellPathDropdown:SetValues(v3_GetSavedSellPathNames())
            Options.LoadSellPathDropdown:SetValue(name)
        end
    else
        Notify("Error saving sell path: " .. tostring(err), 3, true)
    end
end

function v3_LoadSellPath(name)
    if not name or name == "" then
        Notify("Select a sell path to load!", 2, true)
        return
    end
    v3_EnsureSellPathFolder()
    local ok, json = pcall(function()
        return readfile(v3_SELL_PATHS_FOLDER .. "/" .. name .. ".json")
    end)
    if not ok or not json or json == "" then
        Notify("Failed to load sell path: " .. name, 2, true)
        return
    end
    local parseOk, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(json)
    end)
    if not parseOk or type(data) ~= "table" then
        Notify("Corrupt sell path file: " .. name, 2, true)
        return
    end

    v3_savedSellPathPositions = {}
    v3_sellVisualFolder:ClearAllChildren()
    local lastPos = nil
    for _, p in ipairs(data) do
        local pos = Vector3.new(p.x, p.y, p.z)
        table.insert(v3_savedSellPathPositions, pos)
        v3_CreateSellPoint(pos)
        if lastPos then v3_DrawSellLine(lastPos, pos) end
        lastPos = pos
    end
    v3_lastSellPointPos, v3_lastSellFloorPos = nil, nil
    Notify("Sell Path '" .. name .. "' loaded! (" .. #data .. " points)", 3)
end

function v3_DeleteSellPath(name)
    if not name or name == "" then
        Notify("Select a sell path to delete!", 2, true)
        return
    end
    v3_EnsureSellPathFolder()
    local path = v3_SELL_PATHS_FOLDER .. "/" .. name .. ".json"
    pcall(function()
        if isfile and isfile(path) then
            delfile(path)
        end
    end)
    Notify("Sell Path '" .. name .. "' deleted!", 2)
    if Options and Options.LoadSellPathDropdown then
        Options.LoadSellPathDropdown:SetValues(v3_GetSavedSellPathNames())
    end
end

function v3_GetSavedSellPathNames()
    v3_EnsureSellPathFolder()
    local names = {}
    pcall(function()
        local files = listfiles(v3_SELL_PATHS_FOLDER)
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(names, n) end
        end
    end)
    return names
end

function v3_GetClosestSellWaypointIndex(pos)
    if #v3_savedSellPathPositions == 0 then return 1 end
    local closestIndex = 1
    local shortestDist = math.huge
    for idx, wp in ipairs(v3_savedSellPathPositions) do
        local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(wp.X, 0, wp.Z)).Magnitude
        if dist < shortestDist then
            shortestDist = dist
            closestIndex = idx
        end
    end
    return closestIndex
end

function v3_FollowSellPath()
    if #v3_savedSellPathPositions == 0 then return false end
    local char = getTWWCharacter(LocalPlayer)
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local head = char and char:FindFirstChild("Head")
    if not (char and humanoid and hrp and head) then return false end

    local startIdx = v3_GetClosestSellWaypointIndex(hrp.Position)

    for i = startIdx, #v3_savedSellPathPositions do
        if not (v3_isAutoFarming or v3_isAutoSelling) then break end
        local targetPos = v3_savedSellPathPositions[i]
        humanoid.WalkSpeed = v3_sellSpeed

        local lastCheck = head.Position
        local lastStuck = os.clock()
        local t0 = os.clock()

        while (v3_isAutoFarming or v3_isAutoSelling) and humanoid.Parent do
            local headPos = head.Position
            local flatDiff = (targetPos * Vector3.new(1, 0, 1) - headPos * Vector3.new(1, 0, 1))
            local flatDist = flatDiff.Magnitude

            if flatDist < 5 and math.abs(targetPos.Y - headPos.Y) <= 10 then
                break
            end

            if flatDist >= 1 then
                humanoid:Move((targetPos - headPos).Unit, false)
            end

            RunService.RenderStepped:Wait()

            -- Anti-stuck
            if os.clock() - lastStuck > 1.2 then
                if (head.Position - lastCheck).Magnitude < 1 then
                    humanoid.Jump = true
                end
                lastCheck = head.Position
                lastStuck = os.clock()
            end

            if os.clock() - t0 > 25 then break end
        end
    end

    -- Arrived at the end of Sell Path -> Sell Loot
    humanoid:Move(Vector3.zero, false)
    task.wait(0.5)
    v3_AutoSellLoot()
    task.wait(1.5)
    return true
end

function v3_RunAutoSell()
    task.spawn(function()
        while v3_isAutoSelling do
            if #v3_savedSellPathPositions == 0 then
                v3_isAutoSelling = false
                Notify("No Sell Path loaded to run!", 2, true)
                break
            end
            v3_FollowSellPath()
            task.wait(2)
        end
    end)
end

-- Main auto farm loop — follows V.3 Fix Auto Farm.lua logic
function v3_RunAutoFarm()
    task.spawn(function()
        EnsurePickaxeEquipped()

        local initChar = getTWWCharacter(LocalPlayer)
        local initHrp = initChar and initChar:FindFirstChild("HumanoidRootPart")
        local startIdx = 1
        if initHrp and #v3_savedPathPositions > 0 then
            startIdx = v3_GetClosestWaypointIndex(initHrp.Position)
        end

        local isFirstCycle = true

        while v3_isAutoFarming do
            if #v3_savedPathPositions == 0 then
                v3_isAutoFarming = false
                break
            end

            local startFrom = isFirstCycle and startIdx or 1
            isFirstCycle = false

            for i = startFrom, #v3_savedPathPositions do
                if not v3_isAutoFarming then break end
                local char = getTWWCharacter(LocalPlayer)
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local head = char and char:FindFirstChild("Head")
                if not (char and humanoid and hrp and head) then
                    task.wait(0.5)
                    continue
                end

                EnsurePickaxeEquipped()
                local targetPos = v3_savedPathPositions[i]
                humanoid.WalkSpeed = v3_farmSpeed

                local lastCheck = head.Position
                local lastStuck = os.clock()
                local t0 = os.clock()

                while v3_isAutoFarming and humanoid.Parent do
                    -- ORE CHECK (Detect within 12 studs, step in to 5.5 studs)
                    local foundOre = false
                    for _, ore in pairs(v3_GetActiveOres()) do
                        if ore.OreCategory and v3_oreTargets[ore.OreCategory] == false then continue end
                        if ore.Part and hrp and (hrp.Position - ore.Part.Position).Magnitude <= 12 then
                            foundOre = true

                            -- Step forward right in front of ore into melee striking range (~5.5 studs)
                            local approachT0 = os.clock()
                            while (hrp.Position - ore.Part.Position).Magnitude > 5.5 and (os.clock() - approachT0 < 1.5) and v3_isAutoFarming do
                                local toOre = (Vector3.new(ore.Part.Position.X, hrp.Position.Y, ore.Part.Position.Z) - hrp.Position)
                                if toOre.Magnitude > 0.5 then
                                    humanoid:Move(toOre.Unit, false)
                                else
                                    break
                                end
                                RunService.RenderStepped:Wait()
                            end

                            -- === STOP CHARACTER DIRECTLY IN FRONT OF ORE ===
                            humanoid:Move(Vector3.zero, false)
                            task.wait(0.05)
                            EnsurePickaxeEquipped()

                            -- Highlight ore
                            local hl = ore.Model:FindFirstChild("OreHighlight") or Instance.new("Highlight", ore.Model)
                            hl.Name = "OreHighlight"
                            hl.FillTransparency = 1
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                            hl.OutlineTransparency = 0.1

                            -- === LOCK CAMERA FULLY on ore ===
                            local camConn = RunService.RenderStepped:Connect(function()
                                local cam = Workspace.CurrentCamera
                                if hrp and cam and ore.Part and ore.Remaining.Value > 0 and v3_isAutoFarming then
                                    hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(ore.Part.Position.X, hrp.Position.Y, ore.Part.Position.Z))
                                    cam.CameraType = Enum.CameraType.Scriptable
                                    local camPos = hrp.Position + Vector3.new(0, 3.5, 0) + (hrp.CFrame.LookVector * -6)
                                    cam.CFrame = CFrame.lookAt(camPos, ore.Part.Position)
                                end
                            end)

function GetPickaxeCooldown(gun)
    if not gun then return 1.05 end
    local baseCd = gun.Cooldown
    if not baseCd and gun.SharedData and gun.SharedData.MeleeAnims and gun.SharedData.MeleeAnims.Swing then
        baseCd = gun.SharedData.MeleeAnims.Swing.Cooldown
    end
    return math.max(0.95, (baseCd or 0.85) + 0.1)
end

                            -- === MINE UNTIL FULLY DEPLETED ===
                            local hitTimeout = os.clock()
                            local lastSwing = 0

                            while ore.Remaining.Value > 0 and v3_isAutoFarming do
                                if ore.OreCategory and v3_oreTargets[ore.OreCategory] == false then break end

                                local pc = Global.PlayerCharacter
                                local gun = pc and pc:GetEquippedItem()
                                if gun and gun.IsEquipped and (GetPickaxeTier(gun) > 0 or string.find(tostring(gun.Model):lower(), "pickaxe")) then
                                    local cd = GetPickaxeCooldown(gun)
                                    if tick() - lastSwing >= cd then
                                        lastSwing = tick()
                                        local useLegit = (FarmerConfig.MiningMode == 'Legit Swing (Realistic)')

                                        if useLegit then
                                            -- Legit mode: call the native PickaxeItemType Swing method.
                                            -- Plays the swing animation, woosh sound, and registers hit without duplicate packets
                                            pcall(function()
                                                if gun.Swing then
                                                    gun:Swing()
                                                elseif gun.Attack then
                                                    gun:Attack()
                                                else
                                                    VirtualUser:CaptureController()
                                                    VirtualUser:Button1Down(Vector2.new(0, 0))
                                                    task.wait(0.05)
                                                    VirtualUser:Button1Up(Vector2.new(0, 0))
                                                end
                                            end)
                                        else
                                            -- Mine Aura: send the network hit with correct timing
                                            pcall(function()
                                                local hitbox = gun.Hitbox
                                                local hitCF = hitbox.CFrame
                                                local halfSize = hitbox.Size.X / 2
                                                local hitPos = hitCF * Vector3.new(halfSize, 0, 0)
                                                local hitDir = -hitCF.XVector
                                                local t = (Global.SyncedTime and Global.SyncedTime:GetTime()) or tick()
                                                gun:NetworkActivate('MeleeSwing', t, 'Swing')
                                                gun:NetworkActivate('MineDeposit', t, ore.Model, hitPos, hitDir)
                                            end)
                                        end
                                    end
                                end

                                task.wait(0.05)
                                if os.clock() - hitTimeout > 30 then break end
                            end

                            -- Cleanup
                            if ore.Model:FindFirstChild("OreHighlight") then
                                ore.Model.OreHighlight:Destroy()
                            end
                            if camConn then camConn:Disconnect() end
                            Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom

                            EnsurePickaxeEquipped()
                            humanoid.WalkSpeed = v3_farmSpeed
                            t0 = os.clock()
                            lastCheck = head.Position
                            lastStuck = os.clock()
                            break
                        end
                    end

                    if foundOre then continue end

                    -- === WALK TOWARD WAYPOINT ===
                    local headPos = head.Position
                    local flatDiff = (targetPos * Vector3.new(1, 0, 1) - headPos * Vector3.new(1, 0, 1))
                    local flatDist = flatDiff.Magnitude

                    if flatDist < 5 and math.abs(targetPos.Y - headPos.Y) <= 10 then
                        break
                    end

                    if flatDist >= 1 then
                        humanoid:Move((targetPos - headPos).Unit, false)
                    end

                    RunService.RenderStepped:Wait()

                    -- Anti-stuck
                    if os.clock() - lastStuck > 1.2 then
                        if (head.Position - lastCheck).Magnitude < 1 then
                            humanoid.Jump = true
                        end
                        lastCheck = head.Position
                        lastStuck = os.clock()
                    end

                    if os.clock() - t0 > 25 then break end
                end

                -- End of full path loop: follow Sell Path (if available) or sell directly
                if i == #v3_savedPathPositions and v3_isAutoFarming then
                    humanoid:Move(Vector3.zero, false)
                    task.wait(0.5)
                    if FarmerConfig.AutoSell ~= false then
                        if #v3_savedSellPathPositions > 0 then
                            v3_FollowSellPath()
                        else
                            v3_AutoSellLoot()
                        end
                    end
                    task.wait(1.5)
                end
            end
        end
    end)
end

