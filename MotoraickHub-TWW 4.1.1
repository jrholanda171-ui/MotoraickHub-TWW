function SetupCombatSilentHooks()
    -- 1. Hook BowItemType:StopDrawing
    pcall(function()
        local bowModule = require(ReplicatedStorage.Modules.Character.Items.Types.BowItemType)
        if bowModule and bowModule.StopDrawing and not bowModule._SilentHooked then
            bowModule._SilentHooked = true
            local OldStopDrawing = bowModule.StopDrawing
            bowModule.StopDrawing = function(self, ...)
                if not self.IsDrawing then return OldStopDrawing(self, ...) end
                
                if SilentAim.Enabled and (SilentAim.BowAim ~= false) and math.random(1, 100) <= SilentAim.HitChance then
                    local targetPart = SilentAim.Target or GetClosestTarget()
                    local ArrowModel = self.ArrowModel
                    if targetPart and self.IsAiming and ArrowModel and not Global.PlayerCharacter.IsSprinting and self.IsEquipped and not (Global.PlayerCharacter:IsRolling()) then
                        self.IsDrawing = false
                        Global.BowUI.SetVisible(false)
                        if self.VibrateSound then self.VibrateSound:Destroy(); self.VibrateSound = nil end

                        local v1 = Global.SharedProjectiles.ResolveProjectileOrigin(Global.PlayerCharacter.RootPart.Position, ArrowModel.ArrowHandle.Position)
                        local v2 = tick() - self.StartedDrawing
                        local v3 = math.min(1, v2 / self:GetDrawTime())
                        local ArrowType = self.State.ArrowType
                        ArrowModel:Destroy()
                        self.ArrowModel = nil
                        self.State.HasArrow = false
                        self.State.ArrowType = nil
                        self:UpdateState()

                        -- Precise direction to target with gravity drop & velocity prediction
                        local targetPos = targetPart.Position
                        local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
                        local dist = (targetPos - v1).Magnitude
                        local speed = 250
                        local flightTime = dist / speed
                        local dropComp = Vector3.new(0, 0.5 * 32 * (flightTime ^ 2), 0)
                        local predictedPos = targetPos + (vel * flightTime) + dropComp
                        local aimDirection = (predictedPos - v1).Unit

                        Global.ProjectileHandler:InitProjectiles("ArrowProjectile", self.SharedData, {
                            origin = v1,
                            direction = aimDirection,
                            accuracy = 1,
                            power = math.max(v3, 0.9),
                            ammoType = ArrowType,
                            drawStart = self.State.DrawStart,
                        }, function(p1)
                            self:NetworkActivate("ShootArrow", p1)
                        end)

                        self:PlayTrack("Release", 0, 1, 1)
                        self.IsShooting = true
                        task.delay(self:GetTrack("Release").Length, function() self.IsShooting = false end)
                        Global.UIHandler:DisableResetButtonFor(10)

                        self.IsAiming = false
                        self.StartedPulling = nil
                        self.StartedDrawing = nil
                        self.State.ActuallyStartedDrawing = nil
                        self:UpdateState()
                        self:StopTrack("Knock", 0.25)
                        self:StopTrack("Aim", 0.25)
                        self:StopTrack("Draw", 0.25)
                        self:StopTrack("Drawn", 0.25)
                        self:PlayTrack("Idle", 0.25, 1, 1)
                        if self.LastDrawSound then self.LastDrawSound:Stop(); self.LastDrawSound = nil end
                        return
                    end
                end
                return OldStopDrawing(self, ...)
            end
        end
    end)

    -- 2. Hook LassoItem:OnReleased
    pcall(function()
        local lassoModule = require(ReplicatedStorage.Modules.Character.Items.Special.LassoItem)
        if lassoModule and lassoModule.OnReleased and not lassoModule._SilentHooked then
            lassoModule._SilentHooked = true
            local OldOnReleased = lassoModule.OnReleased
            lassoModule.OnReleased = function(self, ...)
                if self.SwingPower < 1 then
                    self.StartedCharge = nil
                    self.SwingPower = 0
                    self.PercToStay = nil
                    return
                end
                if not self.IsEquipped or not (self:CanThrow()) then
                    return
                end

                if SilentAim.Enabled and (SilentAim.LassoAim ~= false) and math.random(1, 100) <= SilentAim.HitChance then
                    local targetPart = SilentAim.Target or GetClosestTarget()
                    if targetPart then
                        self.IsThrowingLasso = true
                        Global.PlayerCharacter:ToggleMovementBlocker("Lassoing", true)
                        Global.UIHandler:DisableResetButtonFor(10)
                        local trackName = not Global.PlayerCharacter.OnWagon and "Throw" or "ThrowWagon"
                        self:StopTrack("Swing")
                        self:PlayTrack(trackName, 0.1, 1, 1.5)

                        task.spawn(function()
                            self:AsyncTrackKeyframeReached(trackName, "LassoRelease")
                            if not self.IsEquipped or not self.IsThrowingLasso then return end
                            if not self.LassoCircle or not (self.LassoCircle:FindFirstChild("BodyGyro")) then
                                return Global.PlayerCharacter:EquipItem(nil)
                            end
                            Global.ClientSoundHandler:PlayCharacterSound("ClothMove.ClothMove1")
                            local sfx = "LassoThrow" .. math.random(1, 2)
                            Global.ClientSoundHandler:PlayCharacterSound(sfx, {PlaybackSpeed = Global.RNG:NextNumber(0.98, 1.02)})
                            self.CircleWeld.Part1 = nil

                            local LassoCircle = self.LassoCircle
                            local BodyGyro = LassoCircle.BodyGyro
                            local targetPos = targetPart.Position
                            local originPos = LassoCircle.Position
                            local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
                            local dist = (targetPos - originPos).Magnitude
                            local flightTime = dist / 120
                            local predictedPos = targetPos + (vel * flightTime)
                            local dir = (predictedPos - originPos).Unit

                            BodyGyro.MaxTorque = Vector3.new(4000000, 4000000, 4000000)
                            BodyGyro.CFrame = CFrame.new(LassoCircle.Position, predictedPos) * CFrame.Angles(0, -1.5707963267948966, 0)
                            LassoCircle.BodyForce.Force = Vector3.new(0, LassoCircle.Mass * workspace.Gravity * (1 - Global.Params.LassoGravityMult), 0)
                            self:StopTrack(trackName)
                            self:PlayTrack("Hold", 0.1, 1, 1)

                            LassoCircle.Mesh.Scale = Vector3.new(0.1, 0.1, 0.1)
                            local v5 = dir * 120
                            local SelfVelocity = Global.ClientPlatforms:GetSelfVelocity() or Vector3.zero
                            LassoCircle.Velocity = v5 + SelfVelocity
                            self.LassoThrowTime = Global.SyncedTime:GetTime()
                            self:NetworkActivate("ThrowLasso", self.LassoThrowTime, v5, SelfVelocity)
                            self.SwingPower = 0
                            self.PercToStay = nil
                            self.StartedCharge = nil
                            self:UpdateState()

                            self.LassoTouched = LassoCircle.Touched:Connect(function(hit)
                                self:OnHit(hit)
                            end)

                            task.delay(math.clamp(flightTime, 0.05, 0.5), function()
                                if self.IsThrowingLasso and targetPart and targetPart.Parent then
                                    self:OnHit(targetPart)
                                end
                            end)
                        end)
                        return
                    end
                end
                return OldOnReleased(self, ...)
            end
        end
    end)

    -- 3. Hook Global.ProjectileHandler:InitProjectiles (For ALL Guns and Bows)
    pcall(function()
        local ph = Global.ProjectileHandler or require(ReplicatedStorage.SharedModules.World.ProjectileHandler)
        if ph and ph.InitProjectiles and not ph._SilentHooked then
            ph._SilentHooked = true
            local OldInitProjectiles = ph.InitProjectiles
            ph.InitProjectiles = function(self, projType, sharedData, packet, callback)
                if SilentAim.Enabled and (math.random(1, 100) <= SilentAim.HitChance) then
                    local targetPart = SilentAim.Target or GetClosestTarget()
                    if targetPart and type(packet) == "table" and packet.origin then
                        local isBow = (projType == "ArrowProjectile") or (packet.ammoType and tostring(packet.ammoType):find("Arrow"))
                        local isGun = (projType == "Bullet" or projType == "Projectile")
                        
                        if (isBow and SilentAim.BowAim ~= false) or (isGun) then
                            local targetPos = targetPart.Position
                            local vel = targetPart.AssemblyLinearVelocity or Vector3.zero
                            local dist = (targetPos - packet.origin).Magnitude
                            local speed = sharedData and sharedData.ProjectilePower or 250
                            if isBow then speed = 250 end
                            local flightTime = dist / speed
                            local gravY = 32
                            if sharedData and sharedData.Gravity then gravY = math.abs(sharedData.Gravity.Y) end
                            local dropComp = isBow and Vector3.new(0, 0.5 * gravY * (flightTime ^ 2), 0) or Vector3.zero
                            local predictedPos = targetPos + (vel * flightTime) + dropComp
                            packet.direction = (predictedPos - packet.origin).Unit
                            packet.accuracy = 1
                            packet.power = 1
                        end
                    end
                end
                return OldInitProjectiles(self, projType, sharedData, packet, callback)
            end
        end
    end)
end

task.spawn(function()
    pcall(SetupCombatSilentHooks)
end)

function ToggleLagBack(state)
    LagBack.Enabled = state
    if state then
        if LagBack.Connection then LagBack.Connection:Disconnect() end; LagBack.LastPos = nil
        LagBack.Connection = game:GetService("RunService").Heartbeat:Connect(function() local char = getTWWCharacter(LocalPlayer); if not char then return end; local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end; if not LagBack.LastPos then LagBack.LastPos = root.Position; return end; local dist = (root.Position - LagBack.LastPos).Magnitude; if dist > LagBack.Threshold then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero; if Global.Network then Global.Network:FireServer("CharUpdate", root.CFrame) end else LagBack.LastPos = root.Position end end)
    else if LagBack.Connection then LagBack.Connection:Disconnect() end; LagBack.Connection = nil; LagBack.LastPos = nil end
end

