-- EQUIP IN WATER BYPASS
--------------------------------------------------------------------
local EquipWaterBypass = {
    Enabled = false,
    OriginalFunction = nil
}

function SetupEquipWaterBypass()
    if EquipWaterBypass.Enabled then return end
    
    local PlayerCharModule = Global.PlayerCharacter
    
    if not PlayerCharModule then
        pcall(function()
            PlayerCharModule = require(ReplicatedStorage.Modules.PlayerCharacter)
        end)
    end
    
    if not PlayerCharModule then
        warn("[EquipWater] PlayerCharacter module not found!")
        return
    end
    
    -- Save original function
    if not EquipWaterBypass.OriginalFunction then
        EquipWaterBypass.OriginalFunction = PlayerCharModule.CanSwitchToItem
    end
    
    -- Hook: temporarily disable Swimming flag
    PlayerCharModule.CanSwitchToItem = function(self, itemData, ignoreChecks, ...)
        local wasSwimming = self.Swimming
        
        if wasSwimming then
            self.Swimming = false
        end
        
        local result = EquipWaterBypass.OriginalFunction(self, itemData, ignoreChecks, ...)
        
        if wasSwimming then
            self.Swimming = true
        end
        
        return result
    end
    
    EquipWaterBypass.Enabled = true
    Notify("Equip In Water: Enabled", 2)
end

function DisableEquipWaterBypass()
    if not EquipWaterBypass.Enabled then return end
    
    local PlayerCharModule = Global.PlayerCharacter
    
    if PlayerCharModule and EquipWaterBypass.OriginalFunction then
        PlayerCharModule.CanSwitchToItem = EquipWaterBypass.OriginalFunction
    end
    
    EquipWaterBypass.Enabled = false
    Notify("Equip In Water: Disabled", 2)
end

