    hl.OutlineTransparency = 0
end

local LegendaryAutoHopActive = false

function StopLegendaryAutoHop()
    LegendaryAutoHopActive = false
    LegendaryHunter.Active = false
    LegendaryHunter.AutoFind = false
    _G.AutoFindLegendary = nil
    SaveAutoFindState(false)
    if Toggles and Toggles.LegAutoFindToggle and Toggles.LegAutoFindToggle.Value then
        pcall(function() Toggles.LegAutoFindToggle:SetValue(false) end)
    end
    Notify("🛑 Auto Find de Lendários CANCELADO e parado!", 3)
end

function StartLegendaryAutoHop()
    if LegendaryAutoHopActive then return end
    LegendaryAutoHopActive = true
    LegendaryHunter.Active = true
    LegendaryHunter.AutoFind = true
    _G.AutoFindLegendary = true
    SaveAutoFindState(true)
    Notify("🔍 Fazendo varredura completa do servidor (8s)...", 4)

    task.spawn(function()
        while LegendaryAutoHopActive do
            local foundLegendary = nil

            -- Thorough 8-second scan loop with 16 continuous checks
            for checkStep = 1, 16 do
                if not LegendaryAutoHopActive then return end
                local legendaries = FindLegendaryAnimalsInServer()
                if #legendaries > 0 then
                    foundLegendary = legendaries[1]
                    break
                end
                task.wait(0.5)
            end

            if foundLegendary then
                StopLegendaryAutoHop()
                Notify("🌟 ANIMAL LENDÁRIO ENCONTRADO: " .. tostring(foundLegendary.Name) .. "!", 15)
                
                pcall(function()
                    local sound = Instance.new("Sound", Workspace)
                    sound.SoundId = "rbxassetid://6895079853"
                    sound.Volume = 3
                    sound:Play()
                end)
                
                HighlightLegendaryAnimal(foundLegendary.Model, foundLegendary.Name)
                break
            end

            if not LegendaryAutoHopActive then break end

            Notify("Varredura completa: nenhum lendário encontrado. Trocando em 5s...", 4)
            
            for i = 1, 5 do
                task.wait(1)
                if not LegendaryAutoHopActive then
                    Notify("Troca de servidor cancelada.", 2)
                    return
                end
            end

            if not LegendaryAutoHopActive then break end

            pcall(function()
                local queue_func = (syn and syn.queue_on_teleport) or queue_on_teleport or (Fluxus and Fluxus.queue_on_teleport)
                if queue_func and LegendaryAutoHopActive then
                    queue_func([[
                        task.spawn(function()
                            repeat task.wait() until game:IsLoaded()
                            task.wait(5)
                            if StartLegendaryAutoHop then
                                StartLegendaryAutoHop()
                            end
                        end)
                    ]])
                end
            end)

            if not LegendaryAutoHopActive then break end

            local hopped = false
            pcall(function()
                local HttpService = game:GetService("HttpService")
                local req = game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100")
                local data = HttpService:JSONDecode(req)
                if data and data.data and LegendaryAutoHopActive then
                    local validServers = {}
                    for _, s in ipairs(data.data) do
                        if s.id ~= game.JobId and s.playing >= 8 and s.playing < (s.maxPlayers - 2) then
                            table.insert(validServers, s)
                        end
                    end
                    if #validServers > 0 and LegendaryAutoHopActive then
                        local targetServer = validServers[math.random(1, #validServers)]
                        Notify("Conectando ao servidor com " .. tostring(targetServer.playing) .. " jogadores...", 3)
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
                        hopped = true
                    end
                end
            end)

            if not hopped and LegendaryAutoHopActive then
                ServerHop(false)
            end

            task.wait(8)
        end
    end)
end

-- Boot auto-resume from saved disk state
