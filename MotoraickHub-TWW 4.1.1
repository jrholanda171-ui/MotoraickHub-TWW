FlyPlatform = nil
FlyWeld = nil
FlyBV = nil
OldWalkSpeed = nil
FlyCurrentOffset = -3.2

function ToggleFly(enable)
    AntigravityState.FlyEnabled = enable
    if enable then
        -- Auto Noclip if selected
        if not AntigravityState.NoclipEnabled then
            AntigravityState.FlyNoclipAuto = true
            AntigravityState.ToggleNoclip(true)
        end

        local char = getTWWCharacter(LocalPlayer)
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum then
            if FlyPlatform then pcall(function() FlyPlatform:Destroy() end) end
            
            OldWalkSpeed = hum.WalkSpeed
            hum.WalkSpeed = AntigravityState.FlySpeed
            
            -- Set up Collision Groups
            local PhysicsService = game:GetService("PhysicsService")
            pcall(function()
                if PhysicsService.RegisterCollisionGroup then
                    PhysicsService:RegisterCollisionGroup("FlyPlatformGroup")
                    PhysicsService:RegisterCollisionGroup("FlyPlayerGroup")
                else
                    PhysicsService:CreateCollisionGroup("FlyPlatformGroup")
                    PhysicsService:CreateCollisionGroup("FlyPlayerGroup")
                end
                PhysicsService:CollisionGroupSetCollidable("FlyPlatformGroup", "FlyPlayerGroup", true)
                PhysicsService:CollisionGroupSetCollidable("FlyPlatformGroup", "Default", false)
            end)
            
            -- Set character parts to FlyPlayerGroup
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        if PhysicsService.SetPartCollisionGroup then
                            PhysicsService:SetPartCollisionGroup(part, "FlyPlayerGroup")
                        else
                            part.CollisionGroup = "FlyPlayerGroup"
                        end
                    end)
                end
            end
            
            -- Create the physical floating platform
            FlyPlatform = Instance.new("Part")
            FlyPlatform.Name = "FlyPlatform"
            FlyPlatform.Size = Vector3.new(3, 0.2, 3)
            FlyPlatform.Transparency = 1
            FlyPlatform.CanCollide = true
            FlyPlatform.Massless = true
            FlyPlatform.Parent = char
            
            pcall(function()
                if PhysicsService.SetPartCollisionGroup then
                    PhysicsService:SetPartCollisionGroup(FlyPlatform, "FlyPlatformGroup")
                else
                    FlyPlatform.CollisionGroup = "FlyPlatformGroup"
                end
            end)
            
            -- Weld to HumanoidRootPart
            FlyWeld = Instance.new("Weld")
            FlyWeld.Name = "FlyWeld"
            FlyWeld.Part0 = hrp
            FlyWeld.Part1 = FlyPlatform
            FlyWeld.C0 = CFrame.new(0, -3.2, 0)
            FlyWeld.Parent = FlyPlatform
            
            -- Keep Y-axis fixed or move up/down
            FlyBV = Instance.new("BodyVelocity")
            FlyBV.Name = "FlyBV"
            FlyBV.MaxForce = Vector3.new(0, math.huge, 0)
            FlyBV.Velocity = Vector3.new(0, 0, 0)
            FlyBV.Parent = FlyPlatform
            
            -- Update heights on Heartbeat
            AntigravityState.FlyConnection = RunService.Heartbeat:Connect(function(dt)
                local char = getTWWCharacter(LocalPlayer)
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if AntigravityState.FlyEnabled and hrp and hum and FlyWeld and FlyPlatform and FlyBV then
                    -- Keep walkspeed synchronized with slider
                    hum.WalkSpeed = AntigravityState.FlySpeed
                    
                    local yVel = 0
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                        yVel = AntigravityState.FlySpeed
                    elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
                        yVel = -AntigravityState.FlySpeed
                    end
                    
                    FlyBV.Velocity = Vector3.new(0, yVel, 0)
                    
                    -- Reset Y-velocity on HRP so gravity doesn't fight the platform
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, yVel, hrp.AssemblyLinearVelocity.Z)
                else
                    ToggleFly(false)
                end
            end)
        end
    else
        -- Disconnect loop
        if AntigravityState.FlyConnection then 
            AntigravityState.FlyConnection:Disconnect()
            AntigravityState.FlyConnection = nil 
        end
        
        -- Clean up instances
        if FlyPlatform then 
            pcall(function() FlyPlatform:Destroy() end)
            FlyPlatform = nil 
        end
        FlyWeld = nil
        FlyBV = nil
        
        local char = getTWWCharacter(LocalPlayer)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        -- Restore original WalkSpeed
        if hum and OldWalkSpeed then
            hum.WalkSpeed = OldWalkSpeed
        end
        OldWalkSpeed = nil
        
        -- Restore default collision groups
        if char then
            local PhysicsService = game:GetService("PhysicsService")
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        if PhysicsService.SetPartCollisionGroup then
                            PhysicsService:SetPartCollisionGroup(part, "Default")
                        else
                            part.CollisionGroup = "Default"
                        end
                    end)
                end
            end
        end
        
        -- Disable auto Noclip
        if AntigravityState.FlyNoclipAuto then
            AntigravityState.FlyNoclipAuto = false
            AntigravityState.ToggleNoclip(false)
        end
    end
end


function RejoinServer()
    if #Players:GetPlayers() <= 1 then LocalPlayer:Kick("\nRejoining..."); task.wait(); TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end
end

function ServerHop(targetLowPlayers)
    Notify("Buscando servidor...", 3)
    task.spawn(function()
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local sortOrder = targetLowPlayers and "Asc" or "Desc"
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=" .. sortOrder .. "&limit=100")
            local data = HttpService:JSONDecode(req)
            if data and data.data then
                local validServers = {}
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers and s.playing > 0 then
                        table.insert(validServers, s)
                    end
                end
                if #validServers > 0 then
                    local targetServer
                    if targetLowPlayers then
                        table.sort(validServers, function(a, b) return a.playing < b.playing end)
                        targetServer = validServers[1]
                    else
                        targetServer = validServers[math.random(1, #validServers)]
                    end
                    Notify("Conectando ao servidor com " .. tostring(targetServer.playing) .. " jogadores!", 3)
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
                else
                    Notify("Nenhum outro servidor disponível encontrado!", 3, true)
                end
            end
        end)
    end)
end

