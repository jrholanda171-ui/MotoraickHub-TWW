local QuickSwitchActive = false
local QuickSwitchInitialized = false

function InitQuickSwitchAndFastAim()
    if QuickSwitchInitialized then return end
    QuickSwitchInitialized = true

    local AIM_SPEED = 5
    local PC = Global.PlayerCharacter
    
    if PC then
        local OldRequestSwitch = PC.RequestSwitchItems
        PC.RequestSwitchItems = function(self, arg1, arg2, arg3)
            if not QuickSwitchActive then return OldRequestSwitch(self, arg1, arg2, arg3) end
            if self.NextItemToEquip then
                if self.EquippedItemData.Id == self.NextItemToEquip.Id then
                    self.NextItemToEquip = nil
                    if self.IsSwitchingItems then self.SwitchAsync:Abort() end
                    self:UpdateEquippedItem()
                    return
                elseif self.IsSwitchingItems or self.ItemSwitchDisabled then
                    if arg2 then 
                        if self.IsSwitchingItems then self.SwitchAsync:Abort() end
                        self.ItemSwitchDisabled = nil
                        self:RequestSwitchItems(arg1, false, arg3)
                    end
                    return
                elseif self:CanSwitchToItem(self.NextItemToEquip, true) then
                    local nextItem
                    if self.EquippedItemData.Type == "Fist" then nextItem = self.NextItemToEquip self.NextItemToEquip = nil else nextItem = self.DefaultItems.Fist end
                    local equipped = self:GetEquippedItem()
                    if equipped then equipped.IsUnequipping = false end
                    self.SwitchItem = nil
                    self.SwitchAsync = nil
                    self.IsSwitchingItems = false
                    self:_DirectEquipItem(nextItem)
                    self:UpdateEquippedItem()
                    if nextItem.Type ~= "Fist" then self.ItemSwitchDisabled = nil end
                    self:RequestSwitchItems(nil, nil, arg3)
                else
                    self.NextItemToEquip = nil
                    self:UpdateEquippedItem()
                end
            else
                return OldRequestSwitch(self, arg1, arg2, arg3)
            end
        end

        local OldDirectEquip = PC._DirectEquipItem
        PC._DirectEquipItem = function(self, itemData)
            if not QuickSwitchActive then return OldDirectEquip(self, itemData) end
            local item = self:GetItem(itemData.Type)
            local equipped = self:GetEquippedItem()
            if equipped then equipped.IsEquipped = false task.spawn(function() equipped:NetworkUnequip() end) task.spawn(function() equipped:Unequip() end) end
            self.EquippedItemData = itemData
            if self.RepChar and self.RepChar.Holsters then self.RepChar.Holsters:SetEquippedItem(itemData.Id) end
            item.ItemData = itemData
            item.Character = self.Character
            item.AnimationHandler = self.AnimationHandler
            item.IsEquipped = true
            item.LastEquipped = 0
            task.spawn(function() item:NetworkEquip() end)
            task.spawn(function() item:Equip() end)
            task.spawn(function() item:UpdateState() end)
            self:UpdateEquippedItem()
        end
    end

    if Holsters and Holsters.GetEquippingSpeed then
        local oldH = Holsters.GetEquippingSpeed
        Holsters.GetEquippingSpeed = function(...) if QuickSwitchActive then return 999999 end return oldH(...) end
    end
    
    local GunItemType = Global:LoadModule("GunItemType")
    if GunItemType then
        local origPlayTrack = GunItemType.PlayTrack
        GunItemType.PlayTrack = function(self, name, ...)
            local args = {...}
            if QuickSwitchActive and (name == "Aim" or name == "AimIdle") then
                if args[4] then args[4] = AIM_SPEED else table.insert(args, AIM_SPEED) end
                return origPlayTrack(self, name, unpack(args))
            end
            if QuickSwitchActive and (name == "Aim" or name == "AimIdle") then return origPlayTrack(self, name, args[1], args[2], args[3], AIM_SPEED) end
            return origPlayTrack(self, name, ...)
        end
        local origCanShoot = GunItemType.CanShoot
        GunItemType.CanShoot = function(self, check)
            if not QuickSwitchActive then return origCanShoot(self, check) end
            if self.IsUnequipping then return false, "Unequipping" elseif self.IsLoading then return false, "Loading" elseif self.Ammo <= 0 then return false, "NoAmmo" elseif self.BurstShooting and not check then return false, "BurstShooting" else if not check then if not self.IsAiming and not self.HipFiring then return false, "HipFire" end if self.IsReloading or self.GlobalIsReloading then return false end end if self:HasTrack("Fire") then return true end return false, "NoTrack" end
        end
    end

    game:GetService("RunService").RenderStepped:Connect(function()
        if not QuickSwitchActive then return end
        local item = Global.PlayerCharacter:GetEquippedItem()
        if item and item.IsGunItem and item.Tracks then
            for trackName, track in pairs(item.Tracks) do if trackName == "Aim" or trackName == "AimIdle" then if track.Speed and track.Speed < AIM_SPEED then track:AdjustSpeed(AIM_SPEED) end end end
        end
    end)
end

function InflateHead(model)
    local head = model:FindFirstChild("Head")
    if head then
        if not HeadPlus.Cache[head] then HeadPlus.Cache[head] = { Size = head.Size, Transparency = head.Transparency, Material = head.Material, Color = head.Color } end
        head.Size = Vector3.new(HeadPlus.Size, HeadPlus.Size, HeadPlus.Size); head.Transparency = 0.5; head.Material = Enum.Material.Neon; head.Color = Color3.fromRGB(0, 255, 0); head.CanCollide = false
    end
end
function RestoreHead(model)
    local head = model:FindFirstChild("Head")
    if head and HeadPlus.Cache[head] then local data = HeadPlus.Cache[head]; head.Size = data.Size; head.Transparency = data.Transparency; head.Material = data.Material; head.Color = data.Color; HeadPlus.Cache[head] = nil end
end
function ToggleHeadPlus(state)
    HeadPlus.Enabled = state
    local entities = Workspace:FindFirstChild("WORKSPACE_Entities"); if not entities then return end; local players = entities:FindFirstChild("Players")
    if state then
        if players then for _, model in ipairs(players:GetChildren()) do if model.Name ~= LocalPlayer.Name then InflateHead(model) end end
            table.insert(HeadPlus.Connections, players.ChildAdded:Connect(function(model) if model.Name ~= LocalPlayer.Name then task.wait(1); InflateHead(model) end end))
        end
    else
        for _, c in ipairs(HeadPlus.Connections) do c:Disconnect() end; table.clear(HeadPlus.Connections)
        if players then for _, model in ipairs(players:GetChildren()) do RestoreHead(model) end end
    end
end

function UpdateAnimalHitboxes()
    if not AnimalHitbox.Enabled then return end
    local entities = Workspace:FindFirstChild("WORKSPACE_Entities"); local animals = entities and entities:FindFirstChild("Animals"); if not animals then return end
    for _, animal in ipairs(animals:GetChildren()) do
        if animal:IsA("Model") then
            local head = animal:FindFirstChild("Head"); local torso = animal:FindFirstChild("Torso") or animal:FindFirstChild("HumanoidRootPart")
            if head then if not AnimalHitbox.Cache[head] then AnimalHitbox.Cache[head] = head.Size end head.Size = Vector3.new(AnimalHitbox.HeadSize, AnimalHitbox.HeadSize, AnimalHitbox.HeadSize); head.Transparency = AnimalHitbox.Transparency; head.CanCollide = false; head.Material = Enum.Material.Neon; head.Color = Color3.fromRGB(255, 128, 0) end
            if torso then if not AnimalHitbox.Cache[torso] then AnimalHitbox.Cache[torso] = torso.Size end torso.Size = Vector3.new(AnimalHitbox.BodySize, AnimalHitbox.BodySize, AnimalHitbox.BodySize); torso.Transparency = AnimalHitbox.Transparency; torso.CanCollide = false; torso.Material = Enum.Material.Neon; torso.Color = Color3.fromRGB(0, 0, 255) end
        end
    end
end
function RestoreAnimalHitboxes()
    for part, size in pairs(AnimalHitbox.Cache) do if part and part.Parent then part.Size = size; part.Transparency = 0; part.CanCollide = true; part.Material = Enum.Material.Plastic; part.Color = Color3.new(1,1,1) end end; table.clear(AnimalHitbox.Cache)
end
function ToggleAnimalHitbox(state)
    AnimalHitbox.Enabled = state
    if state then game:GetService("RunService"):BindToRenderStep("Motoraick_AnimalHitbox", Enum.RenderPriority.Character.Value + 2, UpdateAnimalHitboxes)
    else game:GetService("RunService"):UnbindFromRenderStep("Motoraick_AnimalHitbox"); RestoreAnimalHitboxes() end
end

function RagdollHorse()
    local entities = Workspace:FindFirstChild("WORKSPACE_Entities"); if not entities then return end; local animals = entities:FindFirstChild("Animals"); if not animals then return end
    local found = false
    for _, entity in ipairs(animals:GetChildren()) do
        if entity:IsA("Model") then
            local owner = entity:FindFirstChild("Owner")
            if owner and owner:IsA("ObjectValue") and owner.Value == LocalPlayer then
                 found = true; pcall(function() Global.Network:FireServer("AnimalKnockOut", entity) end)
                 local hum = entity:FindFirstChild("Humanoid"); if hum then hum.PlatformStand = not hum.PlatformStand; hum:ChangeState(Enum.HumanoidStateType.Physics) end
                 Notify("Horse Ragdolled", 2) 
                 return
            end
        end
    end
    if not found then Notify("No Owned Horse Found", 2, true) end
end

