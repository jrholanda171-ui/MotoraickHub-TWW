                        local root = anim:FindFirstChild("HumanoidRootPart") or anim:FindFirstChild("Torso") or anim:FindFirstChild("Head") or anim:FindFirstChild("Body") or anim.PrimaryPart or anim:FindFirstChildWhichIsA("BasePart")
