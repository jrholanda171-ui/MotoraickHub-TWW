function GetClosestResource(char, maxDist)
    local dist = maxDist or math.huge
    local target = nil
    local interactables = Workspace:FindFirstChild("WORKSPACE_Interactables")
    local mining = interactables and interactables:FindFirstChild("Mining")
    local depositsFolder = mining and mining:FindFirstChild("OreDeposits")
    
    if depositsFolder and char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        for _, oreFolder in ipairs(depositsFolder:GetChildren()) do
            for _, deposit in ipairs(oreFolder:GetChildren()) do
                if deposit:IsA("Model") and deposit.PrimaryPart then
                    local info = deposit:FindFirstChild("DepositInfo")
                    local remaining = info and info:FindFirstChild("OreRemaining")
                    if remaining and remaining.Value > 0 then
                        local d = (deposit.PrimaryPart.Position - myPos).Magnitude
                        if d <= dist then
                            local orePart = deposit:FindFirstChild("Ore") or deposit:FindFirstChildWhichIsA("BasePart") or deposit.PrimaryPart
                            if orePart then
                                target = orePart
                                dist = d
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

function GetOreDeposits(oreType)
    local deposits = {}
    local interactables = Workspace:FindFirstChild("WORKSPACE_Interactables")
    local mining = interactables and interactables:FindFirstChild("Mining")
    local depositsFolder = mining and mining:FindFirstChild("OreDeposits")
    local oreFolder = depositsFolder and depositsFolder:FindFirstChild(oreType)
    
    if oreFolder then
        for _, dep in ipairs(oreFolder:GetChildren()) do
            if dep:IsA("Model") and dep.PrimaryPart then
                local info = dep:FindFirstChild("DepositInfo")
                local remaining = info and info:FindFirstChild("OreRemaining")
                if remaining and remaining.Value > 0 then
                    table.insert(deposits, dep)
                end
            end
        end
    end
    
    local char = getTWWCharacter(LocalPlayer)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        table.sort(deposits, function(a, b)
            return (a.PrimaryPart.Position - hrp.Position).Magnitude < (b.PrimaryPart.Position - hrp.Position).Magnitude
        end)
    end
    
    return deposits
end

local CurrentTargetPos = nil
local waypointFailureCount = 0

function FollowWaypoint(pos)
    CurrentTargetPos = pos
    local char = getTWWCharacter(LocalPlayer)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp then return end
    
    local lastPos = hrp.Position
    local lastCheck = tick()
    local stuckTime = 0
    
    while FarmerConfig.AutoFarm and CurrentTargetPos == pos and (hrp.Position - pos).Magnitude > 5 do
        -- Walk towards pos
        local walkDir = (pos - hrp.Position)
        if walkDir.Magnitude >= 1 then
            hum:Move(walkDir.Unit, false)
        else
            break
        end
        
        -- Stuck detection
        if tick() - lastCheck >= 0.5 then
            local distMoved = (hrp.Position - lastPos).Magnitude
            if distMoved < 1 then
                stuckTime = stuckTime + (tick() - lastCheck)
            else
                stuckTime = 0
            end
            lastPos = hrp.Position
            lastCheck = tick()
        end
        
        if stuckTime >= 3 then
            pcall(function() hum.Jump = true end)
            task.wait(0.5)
            if stuckTime >= 5 then
                waypointFailureCount = waypointFailureCount + 1
                break
            end
        end
        
        RunService.RenderStepped:Wait()
    end
    
    if CurrentTargetPos == pos then
        CurrentTargetPos = nil
    end
end

local PathfindingService = game:GetService("PathfindingService")

function ComputeAndFollowPath(targetPos)
    local char = getTWWCharacter(LocalPlayer)
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local path = PathfindingService:CreatePath({
        WaypointSpacing = 15,
        AgentRadius = 3,
        Costs = {
            Water = math.huge
        }
    })
    
    local success, err = pcall(function()
        path:ComputeAsync(hrp.Position, targetPos)
    end)
    
    if not success or path.Status ~= Enum.PathStatus.Success then
        return false
    end
    
    local waypoints = path:GetWaypoints()
    waypointFailureCount = 0
    
    for i, wp in ipairs(waypoints) do
        if not FarmerConfig.AutoFarm then return false end
        FollowWaypoint(wp.Position)
        if waypointFailureCount >= 3 then
            return false
        end
    end
    return true
end

local PICKAXE_TIER_MAP = {
    tier9pickaxe = 9,
    tier8pickaxe = 8,
    tier7pickaxe = 7,
    tier6pickaxe = 6,
    tier5pickaxe = 5,
    tier4pickaxe = 4,
    tier3pickaxe = 3,
    tier2pickaxe = 2,
    tier1pickaxe = 1,
}

function GetPickaxeTier(item)
    if not item then return 0 end
    local itype = item.Type and tostring(item.Type):lower() or ""
    local iname = item.Name and tostring(item.Name):lower() or ""
    local iid   = item.Id and tostring(item.Id):lower() or ""
    local imodel = item.Model and tostring(item.Model):lower() or ""

    for name, tier in pairs(PICKAXE_TIER_MAP) do
        if itype:find(name) or iname:find(name) or iid:find(name) or imodel:find(name) then
            return tier
        end
    end

    local fullStr = itype .. " " .. iname .. " " .. iid .. " " .. imodel
    local tierNum = fullStr:match("tier%s*(%d+)")
    if tierNum then
        return tonumber(tierNum) or 1
    end

    if fullStr:find("pickaxe") or fullStr:find("pick") then
        return 1
    end

    return 0
end

function GetBestPlayerPickaxe()
    local bestItem = nil
    local bestTier = 0

    if Global.PlayerData then
        local containerNames = { "Hotbar", "Loadout", "Inventory" }
        for _, cName in ipairs(containerNames) do
            local success, container = pcall(function() return Global.PlayerData:GetContainer(cName) end)
            if success and container and container.Items then
                for _, item in pairs(container.Items) do
                    local tier = GetPickaxeTier(item)
                    if tier > bestTier then
                        bestTier = tier
                        bestItem = item
                    end
                end
            end
        end
    end

    return bestItem, bestTier
end

function GetPickaxe(char)
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Model") and not string.match(child.Name:lower(), "loadoutitem") and string.match(child.Name:lower(), "pickaxe") then
            return child
        end
    end
    return nil
end

local lastEquipTime = 0

function EquipPickaxe()
    local char = getTWWCharacter(LocalPlayer)
    -- 1. If already holding a pickaxe in hand in the workspace character, we're good!
    if GetPickaxe(char) then
        return true
    end

    local pc = Global.PlayerCharacter
    if not pc then return false end

    -- Check if weapon controller already has pickaxe equipped
    local equipped = pc:GetEquippedItem()
    if equipped and equipped.IsEquipped then
        local eqTier = GetPickaxeTier(equipped)
        if eqTier > 0 then
            return true
        end
    end

    -- Debounce to prevent animation cancel / spamming _DirectEquipItem
    if os.clock() - lastEquipTime < 1.0 then
        return false
    end
    lastEquipTime = os.clock()

    -- Find the highest tier pickaxe in Hotbar, Loadout, or Inventory
    local bestItem, bestTier = GetBestPlayerPickaxe()
    if bestItem then
        pcall(function()
            pc:_DirectEquipItem(bestItem)
        end)
        return true
    end

    -- Fallback: Equip using name search in inventory
    pcall(function()
        local inv = Global.PlayerData and Global.PlayerData:GetContainer('Inventory')
        if inv and inv.Items then
            for _, item in pairs(inv.Items) do
                local itype = item.Type and tostring(item.Type):lower() or ""
                local iname = item.Name and tostring(item.Name):lower() or ""
                if itype:find("pick") or iname:find("pick") then
                    pc:_DirectEquipItem(item)
                    return true
                end
            end
        end
    end)

    return false
end

function EnsurePickaxeEquipped()
    return EquipPickaxe()
end


function UpdatePlayerESP(player, char)
    local r = char:FindFirstChild("HumanoidRootPart")
    if not r then return end
    
    local hp, maxHp = GetHealthTWW(player, char)
    if PlayerESP.DeadCheck and hp <= 0 then
        local box = r:FindFirstChild("PlayerBoxTag")
        if box then box.Enabled = false end
        local info = r:FindFirstChild("PlayerInfoTag")
        if info then info.Enabled = false end
        return
    end

    local dist = (r.Position - Camera.CFrame.Position).Magnitude
    if dist > PlayerESP.MaxDistance then
        local box = r:FindFirstChild("PlayerBoxTag")
        if box then box.Enabled = false end
        local info = r:FindFirstChild("PlayerInfoTag")
        if info then info.Enabled = false end
        return
    end

    -- Create or get Box tag
    local boxTag = r:FindFirstChild("PlayerBoxTag")
    if PlayerESP.Box2D then
        if not boxTag then
            boxTag = Instance.new("BillboardGui")
            boxTag.Name = "PlayerBoxTag"
            boxTag.Size = UDim2.new(4.2, 0, 6.8, 0)
            boxTag.AlwaysOnTop = true
            boxTag.Adornee = r
            boxTag.Parent = r
            
            local mainFrame = Instance.new("Frame", boxTag)
            mainFrame.Name = "MainFrame"
            mainFrame.Size = UDim2.new(1, 0, 1, 0)
            mainFrame.BackgroundTransparency = 1
            
            local box = Instance.new("Frame", mainFrame)
            box.Name = "Box"
            box.Size = UDim2.new(1, 0, 1, 0)
            box.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            box.BackgroundTransparency = 0.93
            box.BorderSizePixel = 0
            
            local stroke = Instance.new("UIStroke", box)
            stroke.Thickness = 1.5
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        end
        
        boxTag.Enabled = true
        local mainFrame = boxTag:FindFirstChild("MainFrame")
        local box = mainFrame and mainFrame:FindFirstChild("Box")
        local stroke = box and box:FindFirstChild("UIStroke")
        if stroke then
            stroke.Color = PlayerESP.UseTeamColor and player.TeamColor.Color or PlayerESP.BoxColor
        end
    else
        if boxTag then boxTag.Enabled = false end
    end

    -- Standalone Health Bar (Works with or without Box2D)
    local healthBarTag = r:FindFirstChild("PlayerHealthBarTag")
    if PlayerESP.HealthBar then
        if not healthBarTag then
            healthBarTag = Instance.new("BillboardGui")
            healthBarTag.Name = "PlayerHealthBarTag"
            healthBarTag.Size = UDim2.new(0.35, 0, 6.2, 0)
            healthBarTag.StudsOffset = Vector3.new(-2.6, 0, 0)
            healthBarTag.AlwaysOnTop = true
            healthBarTag.Adornee = r
            healthBarTag.Parent = r

            local bg = Instance.new("Frame", healthBarTag)
            bg.Name = "BG"
            bg.Size = UDim2.new(1, 0, 1, 0)
            bg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            bg.BorderSizePixel = 0
            
            local stroke = Instance.new("UIStroke", bg)
            stroke.Thickness = 1
            stroke.Color = Color3.fromRGB(0, 0, 0)

            local bar = Instance.new("Frame", bg)
            bar.Name = "Bar"
