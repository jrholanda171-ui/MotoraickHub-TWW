function InitSpeedBypass() if SpeedBypass.Initialized then return end for _, v in pairs(getgc(true)) do if type(v) == "table" and rawget(v, "Name") == "ACRoll" then SpeedBypass.ACRollRemote = v.Remote end if type(v) == "table" and rawget(v, "Stamina") ~= nil then table.insert(SpeedBypass.StaminaTables, v) end end for _, f in pairs(getgc()) do if type(f) == "function" and islclosure(f) then for _, v in pairs(debug.getupvalues(f)) do if type(v) == "table" and rawget(v, "Stamina") ~= nil then table.insert(SpeedBypass.StaminaTables, v) end end end end SpeedBypass.Initialized = true end
