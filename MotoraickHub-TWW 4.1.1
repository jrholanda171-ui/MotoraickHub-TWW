function ApplyGhost(part)
    if not part:IsA("BasePart") or part.Transparency == 1 then return end
    if not GhostWalls.Cache[part] then GhostWalls.Cache[part] = {Transparency = part.Transparency, Material = part.Material} end
    part.Transparency = GhostWalls.Transparency; part.Material = Enum.Material.SmoothPlastic 
end

function RestoreGhost(part)
    local data = GhostWalls.Cache[part]
    if data then part.Transparency = data.Transparency; part.Material = data.Material; GhostWalls.Cache[part] = nil end
end

function ToggleGhostWalls(state)
    GhostWalls.Enabled = state
    if GhostWalls.Connection then task.cancel(GhostWalls.Connection); GhostWalls.Connection = nil end
    if state then
        GhostWalls.Connection = task.spawn(function()
            while GhostWalls.Enabled do
                local char = getTWWCharacter(LocalPlayer)
                if char then
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if root then
                        local overlapParams = OverlapParams.new(); overlapParams.FilterType = Enum.RaycastFilterType.Include
                        overlapParams.FilterDescendantsInstances = { Workspace:FindFirstChild("WORKSPACE_Geometry"), Workspace:FindFirstChild("WORKSPACE_Static"), Workspace:FindFirstChild("WORKSPACE_Interactables") }
                        local parts = Workspace:GetPartBoundsInRadius(root.Position, GhostWalls.Radius, overlapParams)
                        local currentActive = {}
                        for _, part in ipairs(parts) do if part:IsA("BasePart") then currentActive[part] = true; ApplyGhost(part) end end
                        for part, _ in pairs(GhostWalls.Cache) do if not currentActive[part] then RestoreGhost(part) end end
                    end
                end
                task.wait(0.15)
            end
        end)
    else
        for part, _ in pairs(GhostWalls.Cache) do RestoreGhost(part) end
        table.clear(GhostWalls.Cache)
    end
end

function UpdateGhostTransparency()
    if GhostWalls.Enabled then for part, _ in pairs(GhostWalls.Cache) do part.Transparency = GhostWalls.Transparency; part.Material = Enum.Material.SmoothPlastic end end
end

local RainbowParts = {}
local RainbowOriginals = {}
local RainbowConn = nil
function CacheRainbowParts(char)
    table.clear(RainbowParts); table.clear(RainbowOriginals)
    for _, part in ipairs(char:GetDescendants()) do if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Name ~= "HumanoidRootPart" and not part:IsA("Terrain") then table.insert(RainbowParts, part); RainbowOriginals[part] = {Color = part.Color, Material = part.Material} end end
