function UpdateESPDrawing()
    -- CLEAR CACHE OF DRAWING OVERLAYS
    for player, esp in pairs(ESP_Cache) do
        if not player or not player.Parent then
            for _, d in pairs(esp) do d:Remove() end
            ESP_Cache[player] = nil
        end
    end

    -- DRAW TRACERS & ARROWS ONLY (RUNS EVERY FRAME FOR MAX SMOOTHNESS)
    if PlayerESP.MasterEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = getTWWCharacter(player)
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    if not ESP_Cache[player] then
                        ESP_Cache[player] = {
                            Arrow = CreateDrawing("Triangle", {Filled=true, ZIndex=5, Thickness=1}),
                            Tracer = CreateDrawing("Line", {Thickness=1, ZIndex=4})
                        }
                    end
                    local esp = ESP_Cache[player]
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local dist = (root.Position - Camera.CFrame.Position).Magnitude
                    
                    if dist <= PlayerESP.MaxDistance then
                        if onScreen then
                            if PlayerESP.Tracers then
                                esp.Tracer.Visible = true
                                esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                esp.Tracer.To = Vector2.new(pos.X, pos.Y)
                                esp.Tracer.Color = PlayerESP.TracerColor
                            else
                                esp.Tracer.Visible = false
                            end
                            esp.Arrow.Visible = false
                        else
                            if PlayerESP.ArrowEnabled then
                                esp.Arrow.Visible = true
                                local rel = Camera.CFrame:PointToObjectSpace(root.Position)
                                local angle = math.atan2(rel.Y, rel.X)
                                local radius = PlayerESP.ArrowRadius
                                local center = Camera.ViewportSize / 2
                                local arrowPos = center + Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius)
                                local direction = (center - arrowPos).Unit
                                local perp = Vector2.new(-direction.Y, direction.X)
                                esp.Arrow.PointA = arrowPos + (direction * 25)
                                esp.Arrow.PointB = arrowPos - (perp * 6)
                                esp.Arrow.PointC = arrowPos + (perp * 6)
                                esp.Arrow.Color = PlayerESP.ArrowColor
                                esp.Tracer.Visible = false
                            else
                                esp.Arrow.Visible = false
                            end
                        end
                    else
                        esp.Arrow.Visible = false
                        esp.Tracer.Visible = false
                    end
                end
            end
        end
    end
end

-- THROTTLED BACKGROUND LOOP FOR BILLBOARD GUIS (RUNS 10 TIMES PER SECOND TO PREVENT FPS DROPS)
function UpdateESPAround()
    -- ===========================
    -- [1] PLAYER ESP LOGIC (BILLBOARD GUIS)
    -- ===========================
    if PlayerESP.MasterEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = getTWWCharacter(player)
                if char then
                    UpdatePlayerESP(player, char)
                else
                    ClearPlayerESP(player)
                end
            end
        end
    end

    -- ===========================
    -- [2] ANIMAL ESP LOGIC
    -- ===========================
    if AnimalESP.Enabled then
        local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
        local animals = entities and entities:FindFirstChild("Animals")
        if animals then
            for _, anim in ipairs(animals:GetChildren()) do
                local animName = anim.Name
                local lowerName = animName:lower()
                local shouldDraw = false
                local color = Color3.fromRGB(0, 255, 128)

                if AnimalESP.Bear and lowerName:find("bear") then shouldDraw = true; color = AnimalColors.Bear or color
                elseif AnimalESP.Bison and lowerName:find("bison") then shouldDraw = true; color = AnimalColors.Bison or color
                elseif AnimalESP.Deer and (lowerName:find("deer") or lowerName:find("buck") or lowerName:find("doe")) then shouldDraw = true; color = AnimalColors.Deer or color
                elseif AnimalESP.Gator and (lowerName:find("gator") or lowerName:find("alligator")) then shouldDraw = true; color = AnimalColors.Gator or color
                elseif AnimalESP.Horse and lowerName:find("horse") then shouldDraw = true; color = AnimalColors.Horse or color
                elseif AnimalESP.Capybara and lowerName:find("capybara") then shouldDraw = true; color = AnimalColors.Capybara or color
                elseif AnimalESP.Cow and lowerName:find("cow") then shouldDraw = true; color = AnimalColors.Cow or color
                end

                if shouldDraw then
                    UpdateAnimalESP(anim, animName, color, "AnimalTag")
                else
                    local root = anim:FindFirstChild("HumanoidRootPart") or anim:FindFirstChild("Torso") or anim:FindFirstChild("Head") or anim:FindFirstChild("Body") or anim.PrimaryPart or anim:FindFirstChildWhichIsA("BasePart")
                    local tag = root and root:FindFirstChild("AnimalTag")
                    if tag then tag:Destroy() end
                end
            end
        end
    end

    -- ===========================
    -- [3] LEGENDARY ANIMAL ESP
    -- ===========================
    if AntigravityState.LegendaryAnimalESP.Enabled then
        local entities = Workspace:FindFirstChild("WORKSPACE_Entities")
        local animals = entities and entities:FindFirstChild("Animals")
        if animals then
            for _, anim in ipairs(animals:GetChildren()) do
                if anim:GetAttribute("Legendary") then
                    UpdateAnimalESP(anim, "★ LEGENDARY " .. anim.Name, Color3.fromRGB(255, 215, 0), "LegendaryTag")
                else
                    local root = anim:FindFirstChild("HumanoidRootPart") or anim:FindFirstChild("Torso") or anim:FindFirstChild("Head") or anim:FindFirstChild("Body") or anim.PrimaryPart or anim:FindFirstChildWhichIsA("BasePart")
                    local tag = root and root:FindFirstChild("LegendaryTag")
                    if tag then tag:Destroy() end
                end
            end
        end
    end

    -- ===========================
    -- [4] THUNDERSTRUCK ESP
    -- ===========================
    if AntigravityState.ThunderstruckESP.Enabled then
        for _, m in pairs(game:GetService("CollectionService"):GetTagged("Thunderstruck")) do
            if m and m.Parent then
                UpdateThunderstruckESP(m)
            end
        end
    end

    -- ===========================
    -- [5] WENDIGO ESP LOGIC
    -- ===========================
    if AntigravityState.WendigoESP.Enabled then
